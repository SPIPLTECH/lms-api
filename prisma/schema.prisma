generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phoneNumber    String?         @unique
  address        String?
  password       String
  role           Role            @default(STUDENT)
  refreshToken   String?
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isVerified     Boolean         @default(false)
  otp            String?
  otpExpiresAt   DateTime?
  courses        Course[]
  adminProfile   AdminProfile?
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
}

model StudentProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  education    String?
  phone        String?
  createdAt    DateTime      @default(now())
  dateOfBirth  DateTime?
  guardianName String?
  updatedAt    DateTime      @updatedAt
  certificates Certificate[]
  enrollments  Enrollment[]
  progress     Progress[]
  reviews      Review[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  specialization String?
  qualification  String?
  experience     Int?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  //courses        Course[]
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  department  String?
  designation String?
  permissions String[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id           String        @id @default(cuid())
  title        String
  description  String?
  category     String?
  level        String?
  thumbnailUrl String?
  status       CourseStatus  @default(DRAFT)
  publishedAt  DateTime?
  creatorId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  certificates Certificate[]
  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  modules      Module[]
  quizzes      Quiz[]
  reviews      Review[]
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int
  isPublished Boolean  @default(false)
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
}

model Lesson {
  id          String     @id @default(cuid())
  title       String
  description String?
  order       Int
  isPublished Boolean    @default(false)
  moduleId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  contents    Content[]
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    Progress[]

  @@unique([moduleId, order])
}

model Content {
  id          String      @id @default(cuid())
  order       Int
  lessonId    String
  type        ContentType
  title       String?
  videoUrl    String?
  fileUrl     String?
  htmlContent String?
  externalUrl String?
  duration    Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
}

model Enrollment {
  id         String         @id @default(cuid())
  courseId   String
  enrolledAt DateTime       @default(now())
  studentId  String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Progress {
  id          String         @id @default(cuid())
  lessonId    String
  completed   Boolean        @default(false)
  completedAt DateTime?
  studentId   String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model Quiz {
  id           String     @id @default(cuid())
  title        String
  description  String?
  passingScore Int
  timeLimit    Int?
  courseId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  questions    Question[]
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  question      String
  options       Json
  correctAnswer String
  marks         Int      @default(1)
  createdAt     DateTime @default(now())
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Review {
  id        String         @id @default(cuid())
  rating    Int
  review    String?
  courseId  String
  createdAt DateTime       @default(now())
  studentId String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Certificate {
  id            String         @id @default(cuid())
  certificateNo String         @unique
  courseId      String
  issuedAt      DateTime       @default(now())
  studentId     String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  VIDEO
  DOCUMENT
  TEXT
  LINK
  PRESENTATION
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}
