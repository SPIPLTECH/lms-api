model CourseImportJob {
  id               String             @id @default(cuid())
  instructorId     String
  status           CourseImportStatus @default(UPLOADED)
  sourceFileName   String
  sourcePath       String
  canonicalJson    Json?
  validationReport Json?
  courseId         String?
  errorMessage     String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  instructor User @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
}

enum CourseImportStatus {
  UPLOADED
  EXTRACTING
  ANALYZING
  MAPPING
  READY
  IMPORTING
  COMPLETED
  FAILED
}

model LearningEvent {
  id String @id @default(cuid())

  studentId String
  courseId  String?

  moduleId     String?
  lessonId     String?
  contentId    String?
  quizId       String?
  assignmentId String?
  sessionId    String

  eventType     EventType
  eventCategory EventCategory

  payload  Json?
  metadata Json?

  source    String?
  ipAddress String?
  userAgent String?

  clientTimestamp DateTime?
  createdAt       DateTime  @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([courseId, createdAt])
  @@index([sessionId])
  @@index([eventType, createdAt])
  @@index([eventCategory, createdAt])
  @@index([createdAt])
}

model StudentState {
  id String @id @default(cuid())

  studentId String
  courseId  String
  moduleId  String?
  lessonId  String?
  contentId String?
  timestamp Int?           @default(0)
  updatedAt DateTime       @updatedAt
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
}

model StudentCourseState {
  id        String @id @default(cuid())
  studentId String
  courseId  String

  knowledgeLevel       EntryKnowledgeLevel @default(INTERMEDIATE)
  entryAssessmentScore Float               @default(0)
  confidenceScore      Float               @default(0)

  conceptMastery Json
  strongConcepts Json
  weakConcepts   Json

  originalTotalMinutes     Int @default(0)
  personalizedTotalMinutes Int @default(0)
  timeSavedMinutes         Int @default(0)

  initializedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
}

model ConceptMastery {
  id        String @id @default(cuid())
  studentId String
  concept   String

  masteryScore    Float         @default(0)
  confidenceLevel Float         @default(0)
  status          MasteryStatus @default(UNASSESSED)

  attemptsCount Int    @default(0)
  recentScores  Json?
  trend         String @default("STABLE")

  lastCourseId       String?
  lastAssessedAt     DateTime?
  nextReassessmentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, concept])
  @@index([studentId, status])
  @@index([nextReassessmentAt])
}

model KnowledgeGap {
  id        String @id @default(cuid())
  studentId String
  concept   String

  kc String?

  type       String?
  severity   Float     @default(0)
  status     GapStatus @default(OPEN)
  detectedAt DateTime  @default(now())
  closedAt   DateTime?

  description String?

  confidence Float?

  evidence String?
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([concept])
  @@index([studentId, kc, status])
}

