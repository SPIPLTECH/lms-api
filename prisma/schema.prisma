  dedupeKey       String
  matchPercent    Int
  missingSkills   Json
  priority        JobMatchPriority
  status          JobMatchStatus   @default(ACTIVE)
  reason          String           @db.Text
  version         Int              @default(1)
  generatedAt     DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, dedupeKey])
  @@index([studentId, status])
  @@index([opportunityType, opportunityId])
}

model Application {
  id              String            @id @default(cuid())
  studentId       String
  opportunityType OpportunityType
  opportunityId   String
  driveId         String?
  status          ApplicationStatus @default(APPLIED)
  notes           String?           @db.Text
  appliedAt       DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  student    StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  drive      PlacementDrive? @relation(fields: [driveId], references: [id], onDelete: SetNull)
  interviews Interview[]
  offer      Offer?

  @@unique([studentId, opportunityType, opportunityId])
  @@index([studentId, status])
  @@index([opportunityType, opportunityId])
}

model Interview {
  id            String           @id @default(cuid())
  applicationId String
  studentId     String
  round         Int              @default(1)
  interviewType InterviewType
  scheduledAt   DateTime?
  status        InterviewStatus  @default(SCHEDULED)
  outcome       InterviewOutcome @default(PENDING)
  feedback      String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([studentId, status])
}

model Offer {
  id              String          @id @default(cuid())
  applicationId   String          @unique
  studentId       String
  opportunityType OpportunityType
  opportunityId   String
  role            String
  salary          Int?
  currency        String          @default("INR")
  joiningDate     DateTime?
  status          OfferStatus     @default(PENDING)
  offeredAt       DateTime        @default(now())
  respondedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
}

model ResumeReview {
  id                    String   @id @default(cuid())
  studentId             String
  resumeQualityScore    Int
  portfolioQualityScore Int
  suggestions           Json
  date                  DateTime @db.Date
  createdAt             DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId, date])
}

model PlacementProfile {
  id                      String           @id @default(cuid())
  studentId               String           @unique
  placementReadinessScore Int
  interviewReadinessScore Int
  resumeQualityScore      Int
  portfolioQualityScore   Int
  topJobMatchPercent      Int
  topCompanyMatchScore    Int
  topCompanyId            String?
  topOpportunityType      OpportunityType?
  topOpportunityId        String?
  missingSkillsSummary    Json
  preparationSuggestions  Json
  version                 Int              @default(1)
  lastCalculatedAt        DateTime         @default(now())
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

enum AdminScopeType {
  PLATFORM
  DEPARTMENT
  FACULTY
  COURSE
  STUDENT
}

enum AdminInsightCategory {
  ACADEMIC
  OPERATIONAL
  FINANCIAL
  ENGAGEMENT
  AI_ADOPTION
  RISK
}

enum AdminInsightStatus {
  ACTIVE
  EXPIRED
}

enum StrategicRecommendationType {
  COURSE_IMPROVEMENT
  STAFFING_CHANGE
  CURRICULUM_UPDATE
  RESOURCE_ALLOCATION
  RISK_INTERVENTION
}

enum StrategicRecommendationStatus {
  ACTIVE
  EXPIRED
}

enum ComplianceCheckType {
  CERTIFICATE_INTEGRITY
  COURSE_PUBLISHING_HYGIENE
  AI_DECISION_QUALITY
  DATA_COMPLETENESS
}

enum ComplianceAuditOutcome {
  PASS
  FAIL
}

enum ComplianceSeverity {
  INFO
  WARNING
  CRITICAL
}

enum CapacityResourceType {
  STUDENT_ENROLLMENT
  INSTRUCTOR_CAPACITY
  COURSE_CAPACITY
  INFRASTRUCTURE_LOAD
}

enum ExecutiveReportType {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  SEMESTER
}

enum GovernanceMetricKey {
  POLICY_COMPLIANCE_RATE
  CERTIFICATE_INTEGRITY_RATE
  DATA_COMPLETENESS_RATE
  AI_DECISION_AUDIT_PASS_RATE
  ACCREDITATION_READINESS
}

enum AdminAlertType {
  INSTRUCTOR_OVERLOAD
  INACTIVE_INSTRUCTOR
  DEPARTMENT_DECLINE
  COURSE_DECLINE
  COMPLIANCE_FAILURE
  HIGH_RISK_SURGE
  CAPACITY_WARNING
}

model InstitutionHealth {
  id                      String   @id @default(cuid())
  date                    DateTime @db.Date
  lmsHealthScore          Float
  academicHealthScore     Float
  facultyPerformanceScore Float
  studentSuccessRate      Float
  completionRate          Float
  aiAdoptionScore         Float
  retentionRate           Float
  churnRate               Float
  revenueEstimate         Float
  platformGrowthRate      Float
  activeStudentCount      Int
  activeInstructorCount   Int
  totalEnrollmentCount    Int
  metadata                Json?
  computedAt              DateTime @default(now())

  @@unique([date])
  @@index([date])
}

model DepartmentAnalytics {
  id                       String   @id @default(cuid())
  departmentKey            String
  date                     DateTime @db.Date
  courseCount              Int
  activeStudentCount       Int
  averageCompletionRate    Float
  averageCourseHealthScore Float
  atRiskStudentPercent     Float
  enrollmentTrendPercent   Float
  healthScore              Float
  computedAt               DateTime @default(now())

  @@unique([departmentKey, date])
  @@index([departmentKey, date])
}

model FacultyAnalytics {
  id                           String   @id @default(cuid())
  instructorId                 String
  date                         DateTime @db.Date
  courseCount                  Int
  activeStudentCount           Int
  averageCourseHealthScore     Float
  averageEngagementScore       Float
  averageTeachingEffectiveness Float
  overloadFlag                 Boolean  @default(false)
  inactiveFlag                 Boolean  @default(false)
  performanceScore             Float
  computedAt                   DateTime @default(now())

  @@unique([instructorId, date])
  @@index([instructorId, date])
}

model AdminInsight {
  id              String               @id @default(cuid())
  category        AdminInsightCategory
  scopeType       AdminScopeType
  scopeId         String
  status          AdminInsightStatus   @default(ACTIVE)
  dedupeKey       String
  title           String
  summary         String               @db.Text
  priority        InsightPriority      @default(MEDIUM)
  confidenceScore Int
  evidence        Json?
  version         Int                  @default(1)
  generatedAt     DateTime             @default(now())
  createdAt       DateTime             @default(now())

  @@unique([scopeType, scopeId, dedupeKey])
  @@index([scopeType, scopeId, status])
  @@index([category])
}

model StrategicRecommendation {
  id              String                        @id @default(cuid())
  type            StrategicRecommendationType
  scopeType       AdminScopeType
  scopeId         String
  status          StrategicRecommendationStatus @default(ACTIVE)
  dedupeKey       String
  title           String
  reason          String                        @db.Text
  urgency         Int
  impact          Int
  confidenceScore Int
  evidence        Json?
  version         Int                           @default(1)
  generatedAt     DateTime                      @default(now())
  createdAt       DateTime                      @default(now())

  @@unique([scopeType, scopeId, dedupeKey])
  @@index([scopeType, scopeId, status])
  @@index([type])
}

model ComplianceAudit {
  id        String                 @id @default(cuid())
  checkType ComplianceCheckType
  outcome   ComplianceAuditOutcome
  severity  ComplianceSeverity
  scopeType AdminScopeType
  scopeId   String
  findings  String                 @db.Text
  evidence  Json?
  runAt     DateTime               @default(now())

  @@index([checkType, runAt])
  @@index([scopeType, scopeId])
}

model CapacityForecast {
  id                String               @id @default(cuid())
  resourceType      CapacityResourceType
  forecastDate      DateTime             @db.Date
  predictedValue    Float
  confidenceScore   Int
  method            String
  basedOnDataPoints Int
  computedAt        DateTime             @default(now())

  @@unique([resourceType, forecastDate])
  @@index([resourceType])
}

model AdminAlert {
  id          String          @id @default(cuid())
  scopeType   AdminScopeType
  scopeId     String
  alertType   AdminAlertType
  priority    InsightPriority @default(MEDIUM)
  status      InsightStatus   @default(ACTIVE)
  dedupeKey   String
  reason      String          @db.Text
  evidence    Json?
  version     Int             @default(1)
  generatedAt DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([scopeType, scopeId, dedupeKey])
  @@index([scopeType, status, priority])
}

model ExecutiveReport {
  id                String              @id @default(cuid())
  reportType        ExecutiveReportType
  periodStart       DateTime
  periodEnd         DateTime
  summary           String              @db.Text
  healthSnapshot    Json
  departmentSummary Json
  facultySummary    Json
  insights          Json
  recommendations   Json
  alerts            Json
  forecasts         Json
  version           Int                 @default(1)
  generatedAt       DateTime            @default(now())

  @@unique([reportType, periodStart])
  @@index([reportType])
}

model GovernanceMetric {
  id         String              @id @default(cuid())
  metricKey  GovernanceMetricKey
  date       DateTime            @db.Date
  value      Float
  unit       String?
  metadata   Json?
  computedAt DateTime            @default(now())

  @@unique([metricKey, date])
  @@index([metricKey, date])
}

enum MentorMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MentorIntent {
  LEARNING
  ASSESSMENT
  RECOMMENDATION
  CAREER
  PLACEMENT
  MOTIVATION
  ANALYTICS
  ADMINISTRATION
  TECHNICAL_SUPPORT
  NAVIGATION
  GENERAL
}

enum MentorConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AgentInvocationStatus {
  SUCCESS
  FAILURE
  TIMEOUT
}

enum FeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

model MentorConversation {
  id            String                   @id @default(cuid())
  userId        String
  userRole      Role
  title         String?
  status        MentorConversationStatus @default(ACTIVE)
  lastIntent    MentorIntent?
  lastMessageAt DateTime                 @default(now())
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    MentorMessage[]
  contexts    ConversationContext[]
  invocations AgentInvocation[]
  summary     ConversationSummary?

  @@index([userId, status, lastMessageAt])
}

model MentorMessage {
  id               String            @id @default(cuid())
  conversationId   String
  role             MentorMessageRole
  content          String            @db.Text
  intent           MentorIntent?
  intentConfidence Int?
  metadata         Json?
  createdAt        DateTime          @default(now())

  conversation MentorConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contexts     ConversationContext[]
  invocations  AgentInvocation[]
  feedback     ResponseFeedback?

  @@index([conversationId, createdAt])
}

model ConversationContext {
  id             String   @id @default(cuid())
  conversationId String
  messageId      String?
  snapshot       Json
  agentsQueried  Json
  gatheredAt     DateTime @default(now())

  conversation MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      MentorMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId, gatheredAt])
}

model AgentInvocation {
  id             String                @id @default(cuid())
  conversationId String
  messageId      String?
  agentName      String
  method         String
  status         AgentInvocationStatus
  durationMs     Int
  argsSummary    Json?
  resultSummary  Json?
  errorMessage   String?               @db.Text
  invokedAt      DateTime              @default(now())

  conversation MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      MentorMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId, invokedAt])
  @@index([agentName, status])
}

model MentorMemory {
  id        String   @id @default(cuid())
  userId    String
  memoryKey String
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, memoryKey])
  @@index([userId])
}

model ConversationSummary {
  id                    String   @id @default(cuid())
  conversationId        String   @unique
  summaryText           String   @db.Text
  keyTopics             Json
  messageCountAtSummary Int
  version               Int      @default(1)
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  conversation MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model PromptTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  role        Role?
  version     Int      @default(1)
  template    String   @db.Text
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ResponseFeedback {
  id        String         @id @default(cuid())
  messageId String         @unique
  userId    String
  rating    FeedbackRating
  comment   String?        @db.Text
  createdAt DateTime       @default(now())

  message MentorMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CourseImportJob {
  id               String             @id @default(cuid())
  instructorId     String
  status           CourseImportStatus @default(UPLOADED)
  sourceFileName   String
  sourcePath       String
  canonicalJson    Json?
  validationReport Json?
  courseId         String?
  errorMessage     String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  instructor User @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
}

enum CourseImportStatus {
  UPLOADED
  EXTRACTING
  ANALYZING
  MAPPING
  READY
  IMPORTING
  COMPLETED
  FAILED
}
