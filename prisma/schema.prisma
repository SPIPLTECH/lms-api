model ConceptMastery {
  id                 String         @id @default(cuid())
  studentId          String
  concept            String
  masteryScore       Float          @default(0)
  confidenceLevel    Float          @default(0)
  status             MasteryStatus  @default(UNASSESSED)
  attemptsCount      Int            @default(0)
