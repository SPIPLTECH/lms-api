  @@index([studentId, createdAt])
  @@index([status])
  @@index([courseId])
}

model AssessmentAttempt {
  id                    String            @id @default(cuid())
  assessmentId          String
  studentId             String
  attemptNumber         Int
  sourceEventId         String?
  scorePercent          Float?
  passed                Boolean?
