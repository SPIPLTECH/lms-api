  lastBrokenAt               DateTime?
  celebratedStreakMilestones Json?
  updatedAt                  DateTime       @updatedAt
  student                    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([streakStatus])
}

/// *
///  * Daily per-student snapshot — enables trend detection that a single point-in-time read can't give.
model EngagementTrend {
  id                    String         @id @default(cuid())
  studentId             String
  date                  DateTime       @db.Date
  engagementScore       Float          @default(0)
  performanceScore      Float          @default(0)
  dropoutRiskScore      Float          @default(0)
  dailyStudyTimeSeconds Int            @default(0)
  createdAt             DateTime       @default(now())
  student               StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId, date])
}

/// *
///  * Aggregated per (type, date) counters — feeds the future Analytics Agent.
model MotivationAnalytics {
  id                String               @id @default(cuid())
  type              MotivationActionType
  date              DateTime             @db.Date
  generatedCount    Int                  @default(0)
  acknowledgedCount Int                  @default(0)
  dismissedCount    Int                  @default(0)
  expiredCount      Int                  @default(0)
  updatedAt         DateTime             @updatedAt

  @@unique([type, date])
  @@index([date])
}

model StudentAlert {
  id              String          @id @default(cuid())
  courseId        String
  studentId       String
  alertType       AlertType
  priority        InsightPriority @default(MEDIUM)
  status          InsightStatus   @default(ACTIVE)
  confidenceScore Float           @default(0)
  reason          String
  evidence        Json?
  version         Int             @default(1)
  generatedAt     DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student         StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, alertType])
  @@index([courseId, status, priority])
  @@index([studentId])
}

model CourseInsight {
  id                   String            @id @default(cuid())
  courseId             String
  insightType          CourseInsightType
  priority             InsightPriority   @default(MEDIUM)
  status               InsightStatus     @default(ACTIVE)
  confidenceScore      Float             @default(0)
  dedupeKey            String
  title                String
  reason               String
  affectedStudentCount Int               @default(0)
  evidence             Json?
  moduleId             String?
  lessonId             String?
  quizId               String?
  assignmentId         String?
  version              Int               @default(1)
  generatedAt          DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  course               Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, insightType, dedupeKey])
  @@index([courseId, status, priority])
  @@index([insightType])
}

/// *
///  * Singleton per course — the current health snapshot, version-bumped in place like StudentLearningState.
model CourseHealth {
  id                    String    @id @default(cuid())
  courseId              String    @unique
  courseHealthScore     Float     @default(0)
  classEngagementScore  Float     @default(0)
  classPerformanceScore Float     @default(0)
  completionRate        Float     @default(0)
  atRiskStudentPercent  Float     @default(0)
  enrolledCount         Int       @default(0)
  activeStudentCount    Int       @default(0)
  version               Int       @default(1)
  lastCalculatedAt      DateTime?
  updatedAt             DateTime  @updatedAt
  course                Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseHealthScore])
}

model TeachingRecommendation {
  id                   String                     @id @default(cuid())
  courseId             String
  recommendationType   TeachingRecommendationType
  priority             InsightPriority            @default(MEDIUM)
  status               InsightStatus              @default(ACTIVE)
  dedupeKey            String
  suggestedAction      String
  reason               String
  evidence             Json?
  affectedStudentCount Int                        @default(0)
  moduleId             String?
  lessonId             String?
  quizId               String?
  assignmentId         String?
  confidenceScore      Float                      @default(0)
  version              Int                        @default(1)
  generatedAt          DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  course               Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, recommendationType, dedupeKey])
  @@index([courseId, status, priority])
}

/// *
///  * The umbrella periodic report — Weekly/Monthly, bundling counts from the other four models. Naturally append-only by period, so never routed through InsightHistory.
model TeacherInsight {
  id              String            @id @default(cuid())
  courseId        String
  teacherId       String
  reportType      TeacherReportType
  periodStart     DateTime
  periodEnd       DateTime
  summary         String
  highlights      Json
  confidenceScore Float             @default(0)
  generatedAt     DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, reportType, periodStart])
  @@index([teacherId, reportType])
  @@index([courseId, periodStart])
}

/// *
///  * Polymorphic retirement history, spanning StudentAlert/CourseInsight/
///  * TeachingRecommendation — no hard FK possible across three different
///  * source tables, so sourceId is a loose indexed reference by design.
model InsightHistory {
  id              String               @id @default(cuid())
  sourceModel     InsightSourceModel
  sourceId        String
  courseId        String
  studentId       String?
  insightType     String
  priority        InsightPriority
  status          InsightStatus
  confidenceScore Float
  summary         String
  version         Int
  retiredReason   InsightRetiredReason
  generatedAt     DateTime
  retiredAt       DateTime             @default(now())

  @@index([courseId, retiredAt])
  @@index([sourceModel, sourceId])
  @@index([studentId])
}

/// *
///  * Aggregated per (courseId, insightType, date) counters — feeds the future Analytics Agent.
model InsightAnalytics {
  id             String   @id @default(cuid())
  courseId       String
  insightType    String
  date           DateTime @db.Date
  generatedCount Int      @default(0)
  resolvedCount  Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([courseId, insightType, date])
  @@index([date])
}

/// *
///  * Live current value per (scope, metric) — version-bumped in place, same "current row" pattern as CourseHealth.
model KPI {
  id               String                   @id @default(cuid())
  scopeType        AnalyticsScopeType
  scopeId          String
  metricKey        AnalyticsMetricKey
  value            Float
  unit             String?
  trend            AnalyticsTrendDirection?
  changePercent    Float?
  metadata         Json?
  version          Int                      @default(1)
  lastCalculatedAt DateTime                 @default(now())
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([scopeType, scopeId, metricKey])
  @@index([scopeType, scopeId])
  @@index([metricKey])
}

/// *
///  * Append-only per-metric daily fact — the time-series fuel behind TrendAnalysis and Forecast. One row per (scope, metric, day); same-day recompute overwrites, never duplicates.
model AnalyticsHistory {
  id         String             @id @default(cuid())
  scopeType  AnalyticsScopeType
  scopeId    String
  metricKey  AnalyticsMetricKey
  value      Float
  date       DateTime           @db.Date
  recordedAt DateTime           @default(now())

  @@unique([scopeType, scopeId, metricKey, date])
  @@index([scopeType, scopeId, metricKey, date])
}

/// *
///  * Wide daily rollup bundling every metric active for a scope into one document — a single-fetch "what did this scope look like on date X", distinct granularity from AnalyticsHistory's narrow per-metric log. Built by the daily sweep, not on every recompute.
model AnalyticsSnapshot {
  id        String             @id @default(cuid())
  scopeType AnalyticsScopeType
  scopeId   String
  date      DateTime           @db.Date
  metrics   Json
  meta      Json?
  createdAt DateTime           @default(now())

  @@unique([scopeType, scopeId, date])
  @@index([scopeType, scopeId, date])
}

/// *
///  * Precomputed, chart-ready datasets (arrays/breakdowns) — the caching layer GET /analytics/dashboard reads directly instead of recomputing joins per request.
model DashboardMetric {
  id           String             @id @default(cuid())
  scopeType    AnalyticsScopeType
  scopeId      String
  dashboardKey String
  data         Json
  version      Int                @default(1)
  computedAt   DateTime           @default(now())

  @@unique([scopeType, scopeId, dashboardKey])
  @@index([scopeType, scopeId])
}

/// *
///  * Current trend judgment per (scope, metric) — version-bumped in place, refreshed every recompute from AnalyticsHistory.
model TrendAnalysis {
  id            String                  @id @default(cuid())
  scopeType     AnalyticsScopeType
  scopeId       String
  metricKey     AnalyticsMetricKey
  direction     AnalyticsTrendDirection
  changePercent Float
  currentValue  Float
  previousValue Float
  windowDays    Int
  version       Int                     @default(1)
  computedAt    DateTime                @default(now())

  @@unique([scopeType, scopeId, metricKey])
  @@index([scopeType, scopeId])
}

/// *
///  * Predicted future value per (scope, metric, target date) — upserted per recompute for idempotency. Only written once enough AnalyticsHistory exists (see forecastEngine.js); no row is better than a fabricated confident guess from zero history.
model Forecast {
  id                String             @id @default(cuid())
  scopeType         AnalyticsScopeType
  scopeId           String
  metricKey         AnalyticsMetricKey
  forecastDate      DateTime           @db.Date
  predictedValue    Float
  confidenceScore   Int
  method            String
  basedOnDataPoints Int
  computedAt        DateTime           @default(now())

  @@unique([scopeType, scopeId, metricKey, forecastDate])
  @@index([scopeType, scopeId, metricKey])
}

/// *
///  * Periodic administrative report — PLATFORM-scoped only (see index.js docs for why per-course/instructor reports aren't duplicated here). Get-or-generate semantics, same as TeacherInsight's report model.
model Report {
  id          String              @id @default(cuid())
  scopeType   AnalyticsScopeType
  scopeId     String
  reportType  AnalyticsReportType
  periodStart DateTime
  periodEnd   DateTime
  summary     String
  kpiSnapshot Json
  trends      Json
  forecasts   Json
  version     Int                 @default(1)
  generatedAt DateTime            @default(now())

  @@unique([scopeType, scopeId, reportType, periodStart])
  @@index([scopeType, scopeId])
}

/// *
///  * Seeded skill taxonomy + target-role catalog — see ai/jobMarketProvider.js for how industryDemandScore/avgSalary get refreshed.
model IndustryRole {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  category              String
  description           String?
  requiredSkills        Json
  minReadinessScore     Int                    @default(60)
  avgSalaryMin          Int?
  avgSalaryMax          Int?
  currency              String                 @default("INR")
  industryDemandScore   Int                    @default(50)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  careerGoals           CareerGoal[]
  careerProfiles        CareerProfile[]
  careerRecommendations CareerRecommendation[]
  careerRoadmaps        CareerRoadmap[]
  skillGaps             SkillGap[]

  @@index([category])
  @@index([isActive])
}

/// *
///  * A student may hold several goals over time (history via status transitions), but only one ACTIVE at once — enforced in the service layer.
model CareerGoal {
  id           String           @id @default(cuid())
  studentId    String
  targetRoleId String
  status       CareerGoalStatus @default(ACTIVE)
  targetDate   DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetRole   IndustryRole     @relation(fields: [targetRoleId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
}

/// *
///  * Current-row aggregate, one per student, version-bumped in place — same pattern as CourseHealth/StudentLearningState.
model CareerProfile {
  id                   String                 @id @default(cuid())
  studentId            String                 @unique
  readinessScore       Int
  confidenceLevel      CareerConfidenceLevel
  industryReadiness    IndustryReadinessLevel
  skillMatchPercent    Int
  primaryTargetRoleId  String?
  topMatchedRoles      Json
  missingSkillsSummary Json
  version              Int                    @default(1)
  lastCalculatedAt     DateTime               @default(now())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  primaryTargetRole    IndustryRole?          @relation(fields: [primaryTargetRoleId], references: [id])
  student              StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([industryReadiness])
}

/// *
///  * Career Guidance's own materialized skill snapshot, sourced from Assessment's ConceptMastery — this agent's historical skill record, not a live cross-schema join.
model SkillAssessment {
  id             String         @id @default(cuid())
  studentId      String
  skillName      String
  proficiency    Int
  status         String
  source         String         @default("ASSESSMENT_AGENT")
  version        Int            @default(1)
  lastAssessedAt DateTime
  updatedAt      DateTime       @updatedAt
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillName])
  @@index([studentId])
}

/// *
///  * Current row per (student, target role, skill) — recomputed every cycle, closed rather than deleted when the gap resolves.
model SkillGap {
  id            String           @id @default(cuid())
  studentId     String
  targetRoleId  String
  skillName     String
  requiredLevel Int
  currentLevel  Int
  gapSize       Int
  severity      SkillGapSeverity
  status        SkillGapStatus   @default(OPEN)
  version       Int              @default(1)
  detectedAt    DateTime         @default(now())
  closedAt      DateTime?
  updatedAt     DateTime         @updatedAt
  student       StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetRole    IndustryRole     @relation(fields: [targetRoleId], references: [id], onDelete: Cascade)

  @@unique([studentId, targetRoleId, skillName])
  @@index([studentId, status])
}

/// *
///  * Current row, version-bumped in place, upsert by dedupeKey — identical pattern to Recommendation Agent's Recommendation model.
model CareerRecommendation {
  id                   String                     @id @default(cuid())
  studentId            String
  type                 CareerRecommendationType
  priority             CareerPriority
  status               CareerRecommendationStatus @default(ACTIVE)
  dedupeKey            String
  score                Int
  confidenceScore      Int
  reason               String
  estimatedTimeMinutes Int?
  targetRoleId         String?
  metadata             Json?
  version              Int                        @default(1)
  generatedAt          DateTime                   @default(now())
  createdAt            DateTime                   @default(now())
  student              StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetRole           IndustryRole?              @relation(fields: [targetRoleId], references: [id])

  @@unique([studentId, dedupeKey])
  @@index([studentId, status])
  @@index([type])
}

/// *
///  * Immutable snapshot of a CareerRecommendation at the moment it's retired — same convention as RecommendationHistory/MotivationHistory/InsightHistory.
model CareerRecommendationHistory {
  id               String                   @id @default(cuid())
  studentId        String
  recommendationId String
  type             CareerRecommendationType
  priority         CareerPriority
  score            Int
  reason           String
  version          Int
  retiredReason    CareerRetiredReason
  generatedAt      DateTime
  retiredAt        DateTime                 @default(now())
  student          StudentProfile           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, retiredAt])
  @@index([recommendationId])
}

/// *
///  * One current row per (student, horizon) — regenerated whole on every recompute, not incrementally patched.
model CareerRoadmap {
  id           String         @id @default(cuid())
  studentId    String
  targetRoleId String?
  horizon      RoadmapHorizon
  status       RoadmapStatus  @default(ACTIVE)
  milestones   Json
  version      Int            @default(1)
  generatedAt  DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetRole   IndustryRole?  @relation(fields: [targetRoleId], references: [id])

  @@unique([studentId, horizon])
  @@index([studentId])
}

/// *
///  * Append-only daily fact — the time-series backbone for "track career progress over time", same pattern as Analytics' AnalyticsHistory.
model CareerReadinessHistory {
  id                String         @id @default(cuid())
  studentId         String
  readinessScore    Int
  skillMatchPercent Int
  date              DateTime       @db.Date
  recordedAt        DateTime       @default(now())
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId, date])
}

/// *
///  * Current-row aggregate, one per student, version-bumped in place — same pattern as CourseHealth/StudentLearningState/CareerProfile.
model LearningPath {
  id                          String                           @id @default(cuid())
  studentId                   String                           @unique
  currentCourseId             String?
  nextLessonId                String?
  nextModuleId                String?
  recommendedLearningOrder    Json
  priorityTopics              Json
  difficultyAdjustment        LearningPathDifficultyAdjustment @default(STANDARD)
  suggestedStudyMinutesPerDay Int                              @default(30)
  estimatedCompletionDate     DateTime?
  version                     Int                              @default(1)
  lastCalculatedAt            DateTime                         @default(now())
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  student                     StudentProfile                   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

/// *
///  * Current row, version-bumped in place, upsert by dedupeKey — a small fixed set of types (not a competing-candidates pool), so no ranking/cap needed unlike Recommendation/CareerRecommendation.
model LearningRecommendation {
  id          String                         @id @default(cuid())
  studentId   String
  type        LearningRecommendationType
  priority    LearningRecommendationPriority @default(MEDIUM)
  status      LearningRecommendationStatus   @default(ACTIVE)
  dedupeKey   String
  reason      String
  courseId    String?
  moduleId    String?
  lessonId    String?
  metadata    Json?
  version     Int                            @default(1)
  generatedAt DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  student     StudentProfile                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, dedupeKey])
  @@index([studentId, status])
  @@index([type])
}

/// *
///  * One row per (student, planType, period) — DAILY's periodStart is today, WEEKLY's is the Monday of the current week; the daily plan is literally day-zero of the same weekly computation, not a separately derived one.
model StudyPlan {
  id                    String         @id @default(cuid())
  studentId             String
  planType              StudyPlanType
  periodStart           DateTime       @db.Date
  periodEnd             DateTime       @db.Date
  scheduledItems        Json
  suggestedStudyMinutes Int            @default(0)
  version               Int            @default(1)
  generatedAt           DateTime       @default(now())
  student               StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, planType, periodStart])
  @@index([studentId, planType])
}

/// *
///  * Genuinely append-only historical progress — achieved milestones are never deleted, satisfying "Historical Progress" without a dedicated audit table. milestoneKey (e.g. "MODULE_COMPLETION:{moduleId}"/"COURSE_COMPLETION:{courseId}") keeps the unique constraint non-null-safe.
model LearningMilestone {
  id            String          @id @default(cuid())
  studentId     String
  courseId      String
  milestoneType MilestoneType
  milestoneKey  String
  moduleId      String?
  title         String
  status        MilestoneStatus @default(PENDING)
  targetDate    DateTime?
  achievedAt    DateTime?
  version       Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student       StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, milestoneKey])
  @@index([studentId, status])
}

/// *
///  * Current row per (student, topic) — a topic no longer weak on recompute is inferred COMPLETED, not deleted, same "no longer generated -> superseded" logic every other recommendation-owning agent in this series uses.
model RevisionPlan {
  id            String             @id @default(cuid())
  studentId     String
  topic         String
  reason        String
  courseId      String?
  lessonId      String?
  scheduledDate DateTime?
  status        RevisionPlanStatus @default(PENDING)
  version       Int                @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  student       StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, topic])
  @@index([studentId, status])
}

/// *
///  * Read-ready per the schema requirement — this agent's required API surface (see routes/learningPath.routes.js) has no write endpoint for this model, so rows are only ever created by a future endpoint or direct seeding; context/studentContextBuilder.js reads it defensively (null-safe) either way.
model LearningGoal {
  id          String             @id @default(cuid())
  studentId   String
  courseId    String
  goalType    LearningGoalType
  description String?
  targetDate  DateTime?
  status      LearningGoalStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
}

/// *
///  * This agent's own seeded employer catalog.
model Company {
  id                      String                  @id @default(cuid())
  name                    String                  @unique
  industry                String
  website                 String?
  logoUrl                 String?
  description             String?
  isVerified              Boolean                 @default(true)
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  internshipOpportunities InternshipOpportunity[]
  jobOpportunities        JobOpportunity[]
  placementDrives         PlacementDrive[]

  @@index([industry])
  @@index([isActive])
}

model JobOpportunity {
  id                  String            @id @default(cuid())
  companyId           String
  title               String
  description         String?
  requiredSkills      Json
  minExperienceYears  Int               @default(0)
  employmentType      EmploymentType    @default(FULL_TIME)
  location            String?
  isRemote            Boolean           @default(false)
  salaryMin           Int?
  salaryMax           Int?
  currency            String            @default("INR")
  applicationDeadline DateTime?
  status              OpportunityStatus @default(OPEN)
  source              OpportunitySource @default(INTERNAL)
  externalUrl         String?
  postedAt            DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, title])
  @@index([companyId])
  @@index([status])
  @@index([postedAt])
}

model InternshipOpportunity {
  id                  String            @id @default(cuid())
  companyId           String
  title               String
  description         String?
  requiredSkills      Json
  durationWeeks       Int               @default(8)
  stipend             Int?
  currency            String            @default("INR")
  location            String?
  isRemote            Boolean           @default(false)
  isPPO               Boolean           @default(false)
  applicationDeadline DateTime?
  status              OpportunityStatus @default(OPEN)
  source              OpportunitySource @default(INTERNAL)
  externalUrl         String?
  postedAt            DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, title])
  @@index([companyId])
  @@index([status])
  @@index([postedAt])
}

/// *
///  * Campus hiring event for one company, distinct from its individual job/internship postings.
model PlacementDrive {
  id                   String        @id @default(cuid())
  companyId            String
  title                String
  description          String?
  driveDate            DateTime?
  eligibilityCriteria  Json?
  registrationDeadline DateTime?
  status               DriveStatus   @default(UPCOMING)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  applications         Application[]
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, title])
  @@index([companyId])
  @@index([status])
}

/// *
///  * Current row per (student, opportunity), version-bumped in place — same
///  * pattern as CareerRecommendation. opportunityId is a loose polymorphic
///  * reference (spans JobOpportunity and InternshipOpportunity, disambiguated
///  * by opportunityType) — the same convention Teacher Insight's InsightHistory
///  * and Analytics' scopeId already established for one column referencing
///  * more than one heterogeneous parent table.
model JobMatch {
  id              String           @id @default(cuid())
  studentId       String
  opportunityType OpportunityType
  opportunityId   String
  dedupeKey       String
  matchPercent    Int
  missingSkills   Json
  priority        JobMatchPriority
  status          JobMatchStatus   @default(ACTIVE)
  reason          String
  version         Int              @default(1)
  generatedAt     DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  student         StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, dedupeKey])
  @@index([studentId, status])
  @@index([opportunityType, opportunityId])
}

/// *
///  * A student-initiated tracking record only — per the constraint that this
///  * agent must NEVER auto-apply on a student's behalf, creating this row
///  * never submits anything to a real ATS/company; it's this agent's own
///  * record of "the student says they applied," nothing more.
model Application {
  id              String            @id @default(cuid())
  studentId       String
  opportunityType OpportunityType
  opportunityId   String
  driveId         String?
  status          ApplicationStatus @default(APPLIED)
  notes           String?
  appliedAt       DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  drive           PlacementDrive?   @relation(fields: [driveId], references: [id])
  student         StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  interviews      Interview[]
  offer           Offer?

  @@unique([studentId, opportunityType, opportunityId])
  @@index([studentId, status])
  @@index([opportunityType, opportunityId])
}

/// *
///  * One row per interview round/stage for a tracked application.
model Interview {
  id            String           @id @default(cuid())
  applicationId String
  studentId     String
  round         Int              @default(1)
  interviewType InterviewType
  scheduledAt   DateTime?
  status        InterviewStatus  @default(SCHEDULED)
  outcome       InterviewOutcome @default(PENDING)
  feedback      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student       StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([studentId, status])
}

/// *
///  * 1:1 with Application — the offer's status transitions (ACCEPTED/DECLINED)
///  * represent the student's own decision, never made by this agent, per the
///  * constraint that it must never accept/decline offers on their behalf.
model Offer {
  id              String          @id @default(cuid())
  applicationId   String          @unique
  studentId       String
  opportunityType OpportunityType
  opportunityId   String
  role            String
  salary          Int?
  currency        String          @default("INR")
  joiningDate     DateTime?
  status          OfferStatus     @default(PENDING)
  offeredAt       DateTime        @default(now())
  respondedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student         StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
}

/// *
///  * Append-only daily snapshot of resume/portfolio quality — the historical record behind PlacementProfile's current scores, same pattern as CareerReadinessHistory.
model ResumeReview {
  id                    String         @id @default(cuid())
  studentId             String
  resumeQualityScore    Int
  portfolioQualityScore Int
  suggestions           Json
  date                  DateTime       @db.Date
  createdAt             DateTime       @default(now())
  student               StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId, date])
}

/// *
///  * Current-row aggregate, one per student, version-bumped in place — same pattern as CareerProfile.
model PlacementProfile {
  id                      String           @id @default(cuid())
  studentId               String           @unique
  placementReadinessScore Int
  interviewReadinessScore Int
  resumeQualityScore      Int
  portfolioQualityScore   Int
  topJobMatchPercent      Int
  topCompanyMatchScore    Int
  topCompanyId            String?
  topOpportunityType      OpportunityType?
  topOpportunityId        String?
  missingSkillsSummary    Json
  preparationSuggestions  Json
  version                 Int              @default(1)
  lastCalculatedAt        DateTime         @default(now())
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  student                 StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

/// *
///  * Daily platform-wide health snapshot — the "current" row is simply the
///  * latest date, so this one table is both InstitutionHealth's live state and
///  * its own history/time-series, no paired history model needed.
model InstitutionHealth {
  id                      String   @id @default(cuid())
  date                    DateTime @unique @db.Date
  lmsHealthScore          Float
  academicHealthScore     Float
  facultyPerformanceScore Float
  studentSuccessRate      Float
  completionRate          Float
  aiAdoptionScore         Float
  retentionRate           Float
  churnRate               Float
  revenueEstimate         Float
  platformGrowthRate      Float
  activeStudentCount      Int
  activeInstructorCount   Int
  totalEnrollmentCount    Int
  metadata                Json?
  computedAt              DateTime @default(now())

  @@index([date])
}

/// *
///  * Per-department (Course.category proxy) daily snapshot/time-series.
model DepartmentAnalytics {
  id                       String   @id @default(cuid())
  departmentKey            String
  date                     DateTime @db.Date
  courseCount              Int
  activeStudentCount       Int
  averageCompletionRate    Float
  averageCourseHealthScore Float
  atRiskStudentPercent     Float
  enrollmentTrendPercent   Float
  healthScore              Float
  computedAt               DateTime @default(now())

  @@unique([departmentKey, date])
  @@index([departmentKey, date])
}

/// *
///  * Per-instructor ("faculty") daily snapshot/time-series. instructorId is a
///  * plain loose reference (User.id, role=INSTRUCTOR) — never a hard FK, same
///  * convention Teacher Insight already uses for instructor-scoped rows.
model FacultyAnalytics {
  id                           String   @id @default(cuid())
  instructorId                 String
  date                         DateTime @db.Date
  courseCount                  Int
  activeStudentCount           Int
  averageCourseHealthScore     Float
  averageEngagementScore       Float
  averageTeachingEffectiveness Float
  overloadFlag                 Boolean  @default(false)
  inactiveFlag                 Boolean  @default(false)
  performanceScore             Float
  computedAt                   DateTime @default(now())

  @@unique([instructorId, date])
  @@index([instructorId, date])
}

/// *
///  * Executive-facing generated insight — same current-row + retire-on-EXPIRED
///  * shape as Recommendation/CareerRecommendation, scoped polymorphically since
///  * an insight can be about the platform, a department, a faculty member, a
///  * course, or a specific at-risk student.
model AdminInsight {
  id              String               @id @default(cuid())
  category        AdminInsightCategory
  scopeType       AdminScopeType
  scopeId         String
  status          AdminInsightStatus   @default(ACTIVE)
  dedupeKey       String
  title           String
  summary         String
  priority        InsightPriority      @default(MEDIUM)
  confidenceScore Int
  evidence        Json?
  version         Int                  @default(1)
  generatedAt     DateTime             @default(now())
  createdAt       DateTime             @default(now())

  @@unique([scopeType, scopeId, dedupeKey])
  @@index([scopeType, scopeId, status])
  @@index([category])
}

/// *
///  * Actionable strategic recommendation for administrators — same
///  * dedupeKey/urgency/impact/confidence competing-candidates shape as
///  * Recommendation Agent's own pipeline. Read-only from this agent's HTTP
///  * surface: no dismiss/act-on endpoint exists in this spec's API list, so
///  * status only ever moves ACTIVE -> EXPIRED via regeneration, never by a
///  * missing write route (same restraint as Learning Path's LearningGoal).
model StrategicRecommendation {
  id              String                        @id @default(cuid())
  type            StrategicRecommendationType
  scopeType       AdminScopeType
  scopeId         String
  status          StrategicRecommendationStatus @default(ACTIVE)
  dedupeKey       String
  title           String
  reason          String
  urgency         Int
  impact          Int
  confidenceScore Int
  evidence        Json?
  version         Int                           @default(1)
  generatedAt     DateTime                      @default(now())
  createdAt       DateTime                      @default(now())

  @@unique([scopeType, scopeId, dedupeKey])
  @@index([scopeType, scopeId, status])
  @@index([type])
}

/// *
///  * Genuinely append-only audit-run ledger — each run of a governance check
///  * produces a new row, never overwritten, the real "Audit AI decisions /
///  * Track policy compliance" record this agent's own Governance framework
///  * generates (there is no pre-existing platform AuditLog to consume).
model ComplianceAudit {
  id        String                 @id @default(cuid())
  checkType ComplianceCheckType
  outcome   ComplianceAuditOutcome
  severity  ComplianceSeverity
  scopeType AdminScopeType
  scopeId   String
  findings  String
  evidence  Json?
  runAt     DateTime               @default(now())

  @@index([checkType, runAt])
  @@index([scopeType, scopeId])
}

/// *
///  * Predicted future resource demand — own linear-regression engine, same OLS
///  * shape as Analytics' Forecast/forecastEngine.js but a separate copy (each
///  * agent owns its own near-identical logic, per established precedent).
model CapacityForecast {
  id                String               @id @default(cuid())
  resourceType      CapacityResourceType
  forecastDate      DateTime             @db.Date
  predictedValue    Float
  confidenceScore   Int
  method            String
  basedOnDataPoints Int
  computedAt        DateTime             @default(now())

  @@unique([resourceType, forecastDate])
  @@index([resourceType])
}

/// *
///  * High-priority operational alert — reuses the existing shared
///  * InsightPriority/InsightStatus enums (same lifecycle as StudentAlert:
///  * ACTIVE until the underlying condition clears on the next generation
///  * cycle, then auto-flips to RESOLVED — no acknowledge/dismiss endpoint
///  * exists in this spec's API list).
model AdminAlert {
  id          String          @id @default(cuid())
  scopeType   AdminScopeType
  scopeId     String
  alertType   AdminAlertType
  priority    InsightPriority @default(MEDIUM)
  status      InsightStatus   @default(ACTIVE)
  dedupeKey   String
  reason      String
  evidence    Json?
  version     Int             @default(1)
  generatedAt DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([scopeType, scopeId, dedupeKey])
  @@index([scopeType, status, priority])
}

/// *
///  * Periodic institution-wide bundle for export — same shape as Analytics'
///  * Report, extended with department/faculty/insight/recommendation/alert
///  * sections since this is the platform-wide executive rollup, not a
///  * metrics-only one.
model ExecutiveReport {
  id                String              @id @default(cuid())
  reportType        ExecutiveReportType
  periodStart       DateTime
  periodEnd         DateTime
  summary           String
  healthSnapshot    Json
  departmentSummary Json
  facultySummary    Json
  insights          Json
  recommendations   Json
  alerts            Json
  forecasts         Json
  version           Int                 @default(1)
  generatedAt       DateTime            @default(now())

  @@unique([reportType, periodStart])
  @@index([reportType])
}

/// *
///  * Governance/compliance/accreditation metric time series — daily
///  * per-metricKey rows, same AnalyticsHistory-style shape.
model GovernanceMetric {
  id         String              @id @default(cuid())
  metricKey  GovernanceMetricKey
  date       DateTime            @db.Date
  value      Float
  unit       String?
  metadata   Json?
  computedAt DateTime            @default(now())

  @@unique([metricKey, date])
  @@index([metricKey, date])
}

/// *
///  * One conversation thread per user. userRole is a snapshot of User.role at
///  * creation time (not a live join) — access control and agent selection
///  * both need "what role was this conversation started as," which must stay
///  * stable even if an admin later changes the user's role.
model MentorConversation {
  id            String                   @id @default(cuid())
  userId        String
  userRole      Role
  title         String?
  status        MentorConversationStatus @default(ACTIVE)
  lastIntent    MentorIntent?
  lastMessageAt DateTime                 @default(now())
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  invocations   AgentInvocation[]
  contexts      ConversationContext[]
  summary       ConversationSummary?
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      MentorMessage[]

  @@index([userId, status, lastMessageAt])
}

/// *
///  * One row per turn (both the user's message and the assistant's reply are
///  * separate rows, same USER/ASSISTANT/SYSTEM shape every LLM chat API uses).
///  * intent is only ever set on USER rows (the classified intent that drove
///  * this turn's orchestration).
model MentorMessage {
  id               String                @id @default(cuid())
  conversationId   String
  role             MentorMessageRole
  content          String
  intent           MentorIntent?
  intentConfidence Int?
  metadata         Json?
  createdAt        DateTime              @default(now())
  invocations      AgentInvocation[]
  contexts         ConversationContext[]
  conversation     MentorConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback         ResponseFeedback?

  @@index([conversationId, createdAt])
}

/// *
///  * Append-only per-turn snapshot of the merged context gathered for one
///  * assistant reply — the real "what did the mentor know when it answered
///  * this" audit record, distinct from MentorMemory (cross-conversation) and
///  * ConversationSummary (compacted history).
model ConversationContext {
  id             String             @id @default(cuid())
  conversationId String
  messageId      String?
  snapshot       Json
  agentsQueried  Json
  gatheredAt     DateTime           @default(now())
  conversation   MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        MentorMessage?     @relation(fields: [messageId], references: [id])

  @@index([conversationId, gatheredAt])
}

/// *
///  * Genuinely append-only orchestration audit ledger — one row per real
///  * downstream agent call (never updated), the real "which agents were
///  * queried, in what order, how long did it take, did it succeed" record the
///  * spec's Orchestration section asks the mentor to decide.
model AgentInvocation {
  id             String                @id @default(cuid())
  conversationId String
  messageId      String?
  agentName      String
  method         String
  status         AgentInvocationStatus
  durationMs     Int
  argsSummary    Json?
  resultSummary  Json?
  errorMessage   String?
  invokedAt      DateTime              @default(now())
  conversation   MentorConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        MentorMessage?        @relation(fields: [messageId], references: [id])

  @@index([conversationId, invokedAt])
  @@index([agentName, status])
}

/// *
///  * Cross-conversation fact ledger — current-row per (userId, memoryKey),
///  * upserted in place, same pattern as CourseHealth/StudentLearningState. A
///  * small fixed vocabulary (see constants/memoryKeys.constants.js), not a
///  * fabricated open-ended semantic memory — this stack has no vector-store
///  * dependency, so "remember previous conversations" is real structured
///  * facts, not embedding similarity retrieval.
model MentorMemory {
  id        String   @id @default(cuid())
  userId    String
  memoryKey String
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, memoryKey])
  @@index([userId])
}

/// *
///  * Current-row, regenerated in place as a conversation grows past the
///  * compaction threshold — recent turns stay verbatim in MentorMessage, older
///  * ones compact here so subsequent prompts don't re-send the entire history.
model ConversationSummary {
  id                    String             @id @default(cuid())
  conversationId        String             @unique
  summaryText           String
  keyTopics             Json
  messageCountAtSummary Int
  version               Int                @default(1)
  updatedAt             DateTime           @updatedAt
  createdAt             DateTime           @default(now())
  conversation          MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

/// *
///  * This agent's own seeded reference data (role-specific system prompts) —
///  * same seeded-catalog precedent as Career Guidance's IndustryRole /
///  * Placement's Company. Idempotently upserted at bootstrap.
model PromptTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  role        Role?
  version     Int      @default(1)
  template    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// *
///  * One feedback row per assistant message — real POST /mentor/feedback
///  * write, this agent's own data only.
model ResponseFeedback {
  id        String         @id @default(cuid())
  messageId String         @unique
  userId    String
  rating    FeedbackRating
  comment   String?
  createdAt DateTime       @default(now())
  message   MentorMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VideoAnalytics {
  id        String         @id @default(cuid())
  studentId String
  lessonId  String
  courseId  String
  watchTime Int            @default(0)
  completed Boolean        @default(false)
  lastPing  DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
