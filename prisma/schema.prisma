/// *
///  * |--------------------------------------------------------------------------
///  * | AI Mentor Agent (Master Orchestrator)
///  * |--------------------------------------------------------------------------
///  * | The final agent — a conversational layer that orchestrates the other 11
///  * | through their own public getters, never by reaching into their tables.
///  * | Its own writes only ever touch the 8 models below.
///  * |
///  * | Naming: the spec asked for `Conversation`/`ConversationMessage`, but
///  * | those names are already taken by a real, live, socket-driven
///  * | human-to-human chat feature elsewhere in this schema (see `Conversation`/
///  * | `Message`/`ConversationParticipant`/`MessageAttachment` above, used by
///  * | modules/conversations + modules/messages + src/socket). Prisma forbids
///  * | duplicate model names, so this agent's models are prefixed
///  * | `Mentor*` — `MentorConversation`/`MentorMessage` — to avoid the
///  * | collision; the other 6 model names (ConversationContext,
///  * | AgentInvocation, MentorMemory, ConversationSummary, PromptTemplate,
///  * | ResponseFeedback) don't collide with anything and are kept as spec'd.
///  * |
///  * | Access to this module is ownership-based, not role-gated (unlike every
///  * | prior agent) — STUDENT/INSTRUCTOR/ADMIN can all use the mentor; role
///  * | only selects which peer agents get queried and which system-prompt
///  * | persona loads (see prompt-builder/).
enum MentorMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MentorIntent {
  LEARNING
  ASSESSMENT
  RECOMMENDATION
  CAREER
  PLACEMENT
  MOTIVATION
  ANALYTICS
  ADMINISTRATION
  TECHNICAL_SUPPORT
  NAVIGATION
  GENERAL
}

enum MentorConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AgentInvocationStatus {
  SUCCESS
  FAILURE
  TIMEOUT
}

enum FeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum CourseImportStatus {
  UPLOADED
  EXTRACTING
  ANALYZING
  MAPPING
  READY
  IMPORTING
  COMPLETED
  FAILED
}

enum PaymentOrderStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
}

model PaymentOrder {
  id                String             @id @default(cuid())
  userId            String
  courseId          String
  razorpayOrderId   String             @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Int
  currency          String             @default("INR")
  status            PaymentOrderStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([userId, courseId, status])
}

