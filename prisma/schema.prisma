  weakConcepts     Json?
  generatedAt      DateTime?
  submittedAt      DateTime?
  evaluatedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  course           Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student          StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model Recommendation {
  id                   String                   @id @default(cuid())
  studentId            String
  type                 RecommendationType
  priority             RecommendationPriority   @default(MEDIUM)
  status               RecommendationStatus     @default(ACTIVE)
  dedupeKey            String
  score                Float                    @default(0)
  confidenceScore      Float                    @default(0)
  reason               String
  estimatedTimeMinutes Int?
  courseId             String?
  moduleId             String?
  lessonId             String?
  metadata             Json?
  version              Int                      @default(1)
  generatedAt          DateTime                 @default(now())
  expiresAt            DateTime?
  updatedAt            DateTime                 @updatedAt
  student              StudentProfile           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feedback             RecommendationFeedback[]
  history              RecommendationHistory[]

  @@unique([studentId, dedupeKey])
  @@index([studentId, status, priority])
  @@index([studentId, type])
  @@index([expiresAt])
}

model RecommendationHistory {
  id               String                      @id @default(cuid())
  recommendationId String
  studentId        String
  type             RecommendationType
  priority         RecommendationPriority
  status           RecommendationStatus
  score            Float
  confidenceScore  Float
  reason           String
  version          Int
  retiredReason    RecommendationRetiredReason
  generatedAt      DateTime
  retiredAt        DateTime                    @default(now())
  recommendation   Recommendation              @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([studentId, retiredAt])
  @@index([recommendationId])
  @@index([type])
}

model RecommendationFeedback {
  id               String                       @id @default(cuid())
  recommendationId String
  studentId        String
  action           RecommendationFeedbackAction
  comment          String?
  createdAt        DateTime                     @default(now())
  recommendation   Recommendation               @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([studentId, action])
  @@index([recommendationId])
}

/// *
///  * Admin-tunable scoring overrides — global, no student relation.
model RecommendationRule {
  id               String              @id @default(cuid())
  ruleKey          String              @unique
  type             RecommendationType?
  weightMultiplier Float               @default(1)
  isActive         Boolean             @default(true)
  description      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([type, isActive])
}

/// *
///  * Aggregated per (type, date) counters — feeds the future Analytics Agent.
model RecommendationAnalytics {
  id             String             @id @default(cuid())
  type           RecommendationType
  date           DateTime           @db.Date
  generatedCount Int                @default(0)
  viewedCount    Int                @default(0)
  acceptedCount  Int                @default(0)
  dismissedCount Int                @default(0)
  completedCount Int                @default(0)
  updatedAt      DateTime           @updatedAt

  @@unique([type, date])
  @@index([date])
}

model MotivationAction {
  id              String               @id @default(cuid())
  studentId       String
  type            MotivationActionType
  priority        MotivationPriority   @default(MEDIUM)
  status          MotivationStatus     @default(ACTIVE)
