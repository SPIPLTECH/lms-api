generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  phoneNumber             String?                   @unique
  address                 String?
  password                String
  role                    Role                      @default(STUDENT)
  refreshToken            String?
  status                  UserStatus                @default(ACTIVE)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  isVerified              Boolean                   @default(false)
  otp                     String?
  otpExpiresAt            DateTime?
  adminProfile            AdminProfile?
  Conversation            Conversation[]
  ConversationParticipant ConversationParticipant[]
  courses                 Course[]
  Message                 Message[]
  studentProfile          StudentProfile?
  teacherProfile          TeacherProfile?
  notifications           Notification[]
  createdQuestions        Question[]
  announcements           Announcement[]
  teachingGoals           TeachingGoal[]
  lessonNotes             InstructorLessonNote[]
  discussions             Discussion[]
  discussionReplies       DiscussionReply[]
}

model StudentProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  education             String?
  phone                 String?
  createdAt             DateTime               @default(now())
  dateOfBirth           DateTime?
  guardianName          String?
  profileVisibility     String?                @default("Public")
  focusTopics           String?                @default("")
  interests             String?                @default("")
  learningGoals         String?                @default("")
  videoQuality          String?                @default("Auto")
  downloadOverWifi      Boolean?               @default(true)
  language              String?                @default("English")
  timezone              String?                @default("GMT+05:30")
  themeMode             String?                @default("Dark Mode")
  plan                  String?                @default("Free Plan")
  updatedAt             DateTime               @updatedAt
  certificates          Certificate[]
  enrollments           Enrollment[]
  progress              Progress[]
  quizSubmissions       QuizSubmission[]
  reviews               Review[]
  stickyNotes           StickyNote[]
  notes                 Note[]
  bookmarks             Bookmark[]
  achievements          StudentAchievement[]
  assignmentSubmissions AssignmentSubmission[]
  batches               Batch[]
  studentStates         StudentState[]
  videoAnalytics        VideoAnalytics[]
  lessonQueries         LessonQuery[]
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  specialization          String?
  qualification           String?
  experience              Int?
  bio                     String?
  notificationPreferences Json?
  language                String?  @default("English")
  timezone                String?  @default("GMT+05:30")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  department  String?
  designation String?
  permissions String[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id                     String           @id @default(cuid())
  title                  String
  description            String?
  category               String?
  level                  String?
  thumbnailUrl           String?
  status                 CourseStatus     @default(DRAFT)
  publishedAt            DateTime?
  creatorId              String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  visibility             CourseVisibility @default(PUBLIC)
  language               String?          @default("English")
  tags                   String[]         @default([])
  certificatesEnabled    Boolean          @default(false)
  discussionEnabled      Boolean          @default(true)
  dripContentEnabled     Boolean          @default(false)
  estimatedLearningHours Float?
  certificates           Certificate[]
  creator                User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  enrollments            Enrollment[]
  modules                Module[]
  quizzes                Quiz[]
  reviews                Review[]
  liveClasses            LiveClass[]
  assignments            Assignment[]
  exams                  Exam[]
  batches                Batch[]
  batchSessions          BatchSession[]
  studentStates          StudentState[]
  videoAnalytics         VideoAnalytics[]
  store                  Store?
  announcements          Announcement[]
  discussions            Discussion[]

  @@index([creatorId])
  @@index([status])
}

enum CourseVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

model Store {
  id            String   @id @default(cuid())
  price         Float    @default(0)
  discountPrice Float?
  currency      String   @default("INR")
  isFree        Boolean  @default(false)
  courseId      String   @unique
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int
  isPublished Boolean  @default(false)
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
  @@index([courseId])
}

model Lesson {
  id              String                 @id @default(cuid())
  title           String
  description     String?
  order           Int
  isPublished     Boolean                @default(false)
  moduleId        String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  contents        Content[]
  module          Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress        Progress[]
  stickyNotes     StickyNote[]
  videoAnalytics  VideoAnalytics[]
  instructorNotes InstructorLessonNote[]
  queries         LessonQuery[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

model Content {
  id          String      @id @default(cuid())
  order       Int
  lessonId    String
  type        ContentType
  title       String?
  videoUrl    String?
  fileUrl     String?
  htmlContent String?
  externalUrl String?
  duration    Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
  @@index([lessonId])
}

model StickyNote {
  id        String         @id @default(cuid())
  content   String
  color     String?        @default("yellow")
  isPinned  Boolean        @default(false)
  timestamp Int?
  studentId String
  lessonId  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([lessonId])
  @@index([studentId, lessonId])
}

model Enrollment {
  id             String         @id @default(cuid())
  courseId       String
  enrolledAt     DateTime       @default(now())
  lastAccessedAt DateTime?
  studentId      String
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
}

model Progress {
  id          String         @id @default(cuid())
  lessonId    String
  completed   Boolean        @default(false)
  completedAt DateTime?
  studentId   String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
}

model Quiz {
  id               String           @id @default(cuid())
  title            String
  description      String?
  instructions     String?          @db.Text
  passingScore     Int
  timeLimit        Int?
  startDate        DateTime?
  dueDate          DateTime?
  availableFrom    DateTime?
  availableUntil   DateTime?
  shuffleQuestions Boolean          @default(false)
  shuffleOptions   Boolean          @default(false)
  negativeMarking  Float            @default(0)
  attempts         Int              @default(1)
  isPublished      Boolean          @default(true)
  status           String?          @default("ACTIVE")
  courseId         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  quizQuestions    QuizQuestion[]
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizSubmissions  QuizSubmission[]

  @@index([courseId])
}

model Question {
  id String @id @default(cuid())

  title        String?
  question     String       @db.Text
  questionType QuestionType @default(MCQ_SINGLE)

  options       Json
  correctAnswer Json

  explanation String? @db.Text

  subject       String?
  topic         String?
  tags          String?         @default("")
  marks         Int             @default(1)
  negativeMarks Float           @default(0)
  difficulty    DifficultyLevel @default(MEDIUM)
  status        String?         @default("ACTIVE")

  createdBy String?
  creator   User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  isRequired  Boolean @default(true)
  isPublished Boolean @default(true)

  order Int?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  quizQuestions QuizQuestion[]

  @@index([difficulty])
  @@index([questionType])
  @@index([subject])
  @@index([topic])
  @@index([createdBy])
  @@index([status])
}

model QuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  questionId  String
  order       Int      @default(1)
  marks       Int      @default(1)
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([quizId, questionId])
  @@index([quizId])
  @@index([questionId])
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

model Review {
  id        String         @id @default(cuid())
  rating    Int
  review    String?
  courseId  String
  createdAt DateTime       @default(now())
  studentId String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model QuizSubmission {
  id            String         @id @default(cuid())
  quizId        String
  studentId     String
  answers       Json
  score         Int
  totalMarks    Int
  percentage    Int
  passed        Boolean        @default(false)
  conceptScores Json?
  submittedAt   DateTime       @default(now())
  quiz          Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, quizId])
  @@index([studentId])
}

model Certificate {
  id            String         @id @default(cuid())
  certificateNo String         @unique
  courseId      String
  issuedAt      DateTime       @default(now())
  studentId     String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Conversation {
  id           String                    @id @default(cuid())
  type         ConversationType
  name         String?
  image        String?
  createdById  String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  User         User                      @relation(fields: [createdById], references: [id])
  participants ConversationParticipant[]
  Message      Message[]

  @@index([createdById])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id                 String              @id @default(cuid())
  conversationId     String
  senderId           String
  content            String?
  isEdited           Boolean             @default(false)
  editedAt           DateTime?
  isDeleted          Boolean             @default(false)
  deletedAt          DateTime?
  isStarred          Boolean             @default(false)
  expiresAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender             User                @relation(fields: [senderId], references: [id])
  messageAttachments MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  fileName  String
  fileUrl   String
  mimeType  String
  size      Int
  type      AttachmentType
  createdAt DateTime       @default(now())
  Message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  VIDEO
  DOCUMENT
  TEXT
  LINK
  PRESENTATION
  IMAGE
