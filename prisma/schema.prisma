/// *
///  * The actual scheduling logic: a per-student recurring cadence, not a one-off action.
model ReminderSchedule {
  id            String               @id @default(cuid())
  studentId     String
  reminderType  MotivationActionType
  cadence       ReminderCadence      @default(DAILY)
  preferredHour Int?                 @default(18)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  student       StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, reminderType])
  @@index([nextRunAt, isActive])
  @@index([studentId])
}

/// *
///  * Reconciled from Student State's engagement domain, plus motivation-specific celebration bookkeeping.
model StudentStreak {
  id                         String         @id @default(cuid())
  studentId                  String         @unique
  currentStreakDays          Int            @default(0)
  longestStreakDays          Int            @default(0)
