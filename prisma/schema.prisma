generator client {
  provider = "prisma-client-js"
  // Loads `include`d relations in one SQL query (LATERAL joins) instead of one
  // round trip per relation level. Against the remote database that took the
  // deep course tree (getCourseById) from ~4.7s to ~0.8s and the course list
  // from ~1.5s to ~0.4s, with identical results. Requires `prisma generate`.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  phoneNumber             String?                   @unique
  address                 String?
  avatar                  String?
  password                String
  role                    Role                      @default(STUDENT)
  refreshToken            String?
  status                  UserStatus                @default(ACTIVE)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  isVerified              Boolean                   @default(false)
  otp                     String?
  otpExpiresAt            DateTime?
  adminProfile            AdminProfile?
  announcements           Announcement[]
  courses                 Course[]
  discussions             Discussion[]
  discussionReplies       DiscussionReply[]
  lessonNotes             InstructorLessonNote[]
  notifications           Notification[]
  createdQuestions        Question[]
  studentProfile          StudentProfile?
  teacherProfile          TeacherProfile?
  teachingGoals           TeachingGoal[]
  courseImportJobs        CourseImportJob[]
  aiConversations         AiConversation[]
  evaluatorAccess         EvaluatorAccess?

  @@index([role])
}

// Temporary evaluator / guest-tester accounts (src/modules/evaluators). The
// user itself is an ordinary STUDENT; this row is what makes it an evaluator.
// Access is fixed at registration — startsAt + 48h — and is never reset.
// Feedback completion is set only by the server after verifying a submission
// on the independent feedback site (or by an admin). Dropping this table
// removes the feature without touching any other model.
model EvaluatorAccess {
  id                   String    @id @default(cuid())
  userId               String    @unique
  startsAt             DateTime
  expiresAt            DateTime
  feedbackCompletedAt  DateTime?
  // The feedback site's submission id; unique so one submission unlocks one account.
  feedbackSubmissionId String?   @unique
  // "FEEDBACK_SITE" or "ADMIN:<userId>"
  feedbackVerifiedBy   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model StudentProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  education         String?
  phone             String?
  createdAt         DateTime  @default(now())
  dateOfBirth       DateTime?
  guardianName      String?
  profileVisibility String?   @default("Public")
  focusTopics       String?   @default("")
  interests         String?   @default("")
  learningGoals     String?   @default("")
  videoQuality      String?   @default("Auto")
  downloadOverWifi  Boolean?  @default(true)
  language          String?   @default("English")
  timezone          String?   @default("GMT+05:30")
  themeMode         String?   @default("Dark Mode")
  plan              String?   @default("Free Plan")

  gender                 String?
  country                String?
  state                  String?
  city                   String?
  highestQualification   String?
  currentQualification   String?
  collegeName            String?
  branchOrStream         String?
  graduationYear         Int?
  semester               String?
  cgpaOrPercentage       Float?
  employmentStatus       EmploymentStatus?
  yearsOfExperience      Float?                  @default(0)
  currentJobRole         String?
  careerGoalText         String?
  preferredLearningStyle PreferredLearningStyle?
  weeklyStudyHours       Int?
  preferredStudyTime     PreferredStudyTime?
  technicalSkills        String[]                @default([])

  updatedAt             DateTime               @updatedAt
  certificates          Certificate[]
  enrollments           Enrollment[]
  quizSubmissions       QuizSubmission[]
  quizAttempts          QuizAttempt[]
  reviews               Review[]
  stickyNotes           StickyNote[]
  notes                 Note[]
  bookmarks             Bookmark[]
  achievements          StudentAchievement[]
  assignmentSubmissions AssignmentSubmission[]
  lessonQueries         LessonQuery[]
  studentState          StudentState[]
  conceptMasteries      ConceptMastery[]
  knowledgeGaps         KnowledgeGap[]
  learningEvents        LearningEvent[]
  contentProgresses     ContentProgress[]
  topicProgresses       TopicProgress[]
  subTopicProgresses    SubTopicProgress[]
  conceptProgresses     ConceptProgress[]
  lessonProgresses      LessonProgress[]
  moduleProgresses      ModuleProgress[]
  quizProgresses        QuizProgress[]
  assignmentProgresses  AssignmentProgress[]
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  specialization          String?
  qualification           String?
  experience              Int?
  bio                     String?
  notificationPreferences Json?
  language                String?  @default("English")
  timezone                String?  @default("GMT+05:30")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  department  String?
  designation String?
  permissions String[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id                     String           @id @default(cuid())
  title                  String
  description            String?
  category               String?
  level                  String?
  thumbnailUrl           String?
  status                 CourseStatus     @default(DRAFT)
  visibility             CourseVisibility @default(PUBLIC)
  language               String?          @default("English")
  tags                   String[]         @default([])
  estimatedLearningHours Float?
  certificatesEnabled    Boolean          @default(false)
  discussionEnabled      Boolean          @default(true)
  
  publishedAt            DateTime?
  creatorId              String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  lastViewedAt           DateTime?
  certificates           Certificate[]
  creator                User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  enrollments            Enrollment[]
  modules                Module[]
  contents               Content[]
  quizzes                Quiz[]
  reviews                Review[]
  assignments            Assignment[]
  exams                  Exam[]

  studentStates       StudentState[]
  learningEvents      LearningEvent[]
  announcements       Announcement[]
  discussions         Discussion[]
  questions           Question[]
  aiConversations     AiConversation[]

  @@index([creatorId])
}

model Module {
  id          String           @id @default(cuid())
  title       String
  description String?
  order       Int
  isPublished Boolean          @default(false)
  courseId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lessons     Lesson[]
  contents    Content[]
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   Question[]
  quizzes     Quiz[]
  assignments Assignment[]
  progresses  ModuleProgress[]

  @@unique([courseId, order])
}

model Lesson {
  id              String                 @id @default(cuid())
  title           String
  description     String?
  order           Int
  isPublished     Boolean                @default(false)
  moduleId        String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  topics          Topic[]
  contents        Content[]
  instructorNotes InstructorLessonNote[]
  module          Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  queries         LessonQuery[]

  stickyNotes    StickyNote[]
  quizzes        Quiz[]
  assignments    Assignment[]
  progresses     LessonProgress[]

  @@unique([moduleId, order])
}

model Topic {
  id          String          @id @default(cuid())
  title       String
  description String?
  order       Int
  isPublished Boolean         @default(false)
  lessonId    String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  contents    Content[]
  lesson      Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quizzes     Quiz[]
  assignments Assignment[]
  progresses  TopicProgress[]
  subTopics   SubTopic[]

  @@unique([lessonId, order])
}

// Optional level between Lesson's Topic and Content. A Topic with no
// SubTopic rows behaves exactly as it always has -- Topic-direct Content,
// Quiz and Assignment stay first-class, so existing courses are unaffected.
model SubTopic {
  id          String             @id @default(cuid())
  title       String
  description String?
  order       Int
  isPublished Boolean            @default(false)
  topicId     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  contents    Content[]
  topic       Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  quizzes     Quiz[]
  assignments Assignment[]
  progresses  SubTopicProgress[]
  concepts    Concept[]

  @@unique([topicId, order])
}

// Optional level below SubTopic. Named for the course-authoring hierarchy --
// unrelated to ConceptMastery/KnowledgeGap.concept, which are learner-model
// knowledge components identified by a free-text string, not by this id.
model Concept {
  id          String            @id @default(cuid())
  title       String
  description String?
  order       Int
  isPublished Boolean           @default(false)
  subTopicId  String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  contents    Content[]
  subTopic    SubTopic          @relation(fields: [subTopicId], references: [id], onDelete: Cascade)
  quizzes     Quiz[]
  assignments Assignment[]
  progresses  ConceptProgress[]

  @@unique([subTopicId, order])
}

// THE learning-sequence entity. Every item a container holds is a Content
// row with exactly one parent (CHECK content_exactly_one_parent), ordered by
// Content.order — the ONLY sequence order. A Quiz or an Assignment takes part
// in a sequence through the Content row that wraps it:
//   type QUIZ        -> quizId set, assignmentId null
//   type ASSIGNMENT  -> assignmentId set, quizId null
//   any other type   -> both null
// (CHECK content_type_link; quizId / assignmentId are unique, so a Quiz or
// Assignment is placed at most once.) Constraints that schema.prisma cannot
// express live in scripts/content-sequence-2-constraints.sql.
model Content {
  id            String              @id @default(cuid())
  order         Int
  courseId      String?
  moduleId      String?
  lessonId      String?
  topicId       String?
  subTopicId    String?
  conceptId     String?
  type          ContentType
  title         String?
  videoUrl      String?
  fileUrl       String?
  htmlContent   String?
  externalUrl   String?
  duration      Int?
  data          Json?
  quizId        String?             @unique
  quiz          Quiz?               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  assignmentId  String?             @unique
  assignment    Assignment?         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  course        Course?             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module        Module?             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson        Lesson?             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topic         Topic?              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subTopic      SubTopic?           @relation(fields: [subTopicId], references: [id], onDelete: Cascade)
  concept       Concept?            @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  progresses    ContentProgress[]
  lessonQueries LessonQuery[]

  @@unique([courseId, order])
  @@unique([moduleId, order])
  @@unique([lessonId, order])
  @@unique([topicId, order])
  @@unique([subTopicId, order])
  @@unique([conceptId, order])
}

model LessonQuery {
  id           String            @id @default(cuid())
  lessonId     String
  // The one item the student asked from — a content block, a quiz or an
  // assignment (at most one is set). All optional so lesson-wide questions
  // (and every existing row) stay valid. A question tied to an item is only
  // ever listed back to the student on that item.
  contentId    String?
  quizId       String?
  assignmentId String?
  studentId    String
  question     String
  reply        String?
  status       LessonQueryStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  answeredAt   DateTime?
  lesson       Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  content      Content?          @relation(fields: [contentId], references: [id], onDelete: SetNull)
  quiz         Quiz?             @relation(fields: [quizId], references: [id], onDelete: SetNull)
  assignment   Assignment?       @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  student      StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([contentId])
  @@index([quizId])
  @@index([assignmentId])
  @@index([studentId])
}

model StickyNote {
  id        String         @id @default(cuid())
  content   String
  color     String?        @default("yellow")
  isPinned  Boolean        @default(false)
  timestamp Int?
  studentId String
  lessonId  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([lessonId])
  @@index([studentId, lessonId])
}

model Enrollment {
  id              String         @id @default(cuid())
  courseId        String
  enrolledAt      DateTime       @default(now())
  lastAccessedAt  DateTime?
  visited         Boolean        @default(false)
  visitedAt       DateTime?
  completed       Boolean        @default(false)
  completedAt     DateTime?
  progressPercent Int            @default(0)
  studentId       String
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model ContentProgress {
  id          String         @id @default(cuid())
  studentId   String
  contentId   String
  visited     Boolean        @default(false)
  visitedAt   DateTime?
  completed   Boolean        @default(false)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content     Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([studentId, contentId])
  @@index([studentId])
  @@index([contentId])
}

model TopicProgress {
  id          String         @id @default(cuid())
  studentId   String
  topicId     String
  visited     Boolean        @default(false)
  visitedAt   DateTime?
  completed   Boolean        @default(false)
  completedAt DateTime?
  // The student passed this topic's QUALIFYING quiz and skipped it. Kept
  // apart from `completed` on purpose: skipped is not studied. Progression
  // treats the two alike (a qualified topic no longer blocks what follows,
  // and counts toward the course percentage), but every read can still tell
  // them apart, and the topic's own contents stay in the course and stay
  // openable. Recomputed by progressRollup from the qualifying attempts, the
  // same way `completed` is recomputed from the topic's items — never the
  // source of truth, always the materialized view of one.
  qualified   Boolean        @default(false)
  qualifiedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic       Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicId])
  @@index([studentId])
  @@index([topicId])
}

model SubTopicProgress {
  id          String         @id @default(cuid())
  studentId   String
  subTopicId  String
  visited     Boolean        @default(false)
  visitedAt   DateTime?
  completed   Boolean        @default(false)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subTopic    SubTopic       @relation(fields: [subTopicId], references: [id], onDelete: Cascade)

  @@unique([studentId, subTopicId])
  @@index([studentId])
  @@index([subTopicId])
}

model ConceptProgress {
  id          String         @id @default(cuid())
  studentId   String
  conceptId   String
  visited     Boolean        @default(false)
  visitedAt   DateTime?
  completed   Boolean        @default(false)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept     Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([studentId, conceptId])
  @@index([studentId])
  @@index([conceptId])
}

model LessonProgress {
  id          String         @id @default(cuid())
  studentId   String
  lessonId    String
  visited     Boolean        @default(false)
  visitedAt   DateTime?
  completed   Boolean        @default(false)
  completedAt DateTime?
  // Skipped by passing this lesson's QUALIFYING quiz — see TopicProgress.
  qualified   Boolean        @default(false)
  qualifiedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
}

model ModuleProgress {
  id          String         @id @default(cuid())
  studentId   String
  moduleId    String
  visited     Boolean        @default(false)
  visitedAt   DateTime?
  completed   Boolean        @default(false)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
  @@index([studentId])
  @@index([moduleId])
}

model QuizProgress {
  id          String         @id @default(cuid())
  studentId   String
  quizId      String
  visited     Boolean        @default(false)
  visitedAt   DateTime?
  completed   Boolean        @default(false)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz        Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([studentId, quizId])
  @@index([studentId])
  @@index([quizId])
}

model AssignmentProgress {
  id           String         @id @default(cuid())
  studentId    String
  assignmentId String
  visited      Boolean        @default(false)
  visitedAt    DateTime?
  completed    Boolean        @default(false)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assignmentId])
  @@index([studentId])
  @@index([assignmentId])
}

model Quiz {
  id               String           @id @default(cuid())
  /// @deprecated Not read or written. A quiz's position in the learning
  /// sequence is its Content(type=QUIZ) row's order. Kept only so branches
  /// still deployed against the shared database keep working; drop once all
  /// have merged.
  order            Int?
  title            String
  description      String?
  quizTag          QuizTag          @default(FINAL)
  passingScore     Int
  timeLimit        Int?
  startDate        DateTime?
  dueDate          DateTime?
  availableFrom    DateTime?
  availableUntil   DateTime?
  isPublished      Boolean          @default(true)
  status           String?          @default("ACTIVE")
  courseId         String
  moduleId         String?
  lessonId         String?
  topicId          String?
  subTopicId       String?
  conceptId        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  questions        Question[]
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module           Module?          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson           Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topic            Topic?           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subTopic         SubTopic?        @relation(fields: [subTopicId], references: [id], onDelete: Cascade)
  concept          Concept?         @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  quizSubmissions  QuizSubmission[]
  quizAttempts     QuizAttempt[]
  quizProgresses   QuizProgress[]
  lessonQueries    LessonQuery[]
  instructions     String?          @db.Text
  shuffleQuestions Boolean          @default(false)
  shuffleOptions   Boolean          @default(false)
  negativeMarking  Float            @default(0)
  attempts         Int              @default(1)
  quizQuestions    QuizQuestion[]
  content          Content?

  @@index([moduleId])
  @@index([topicId])
  @@index([subTopicId])
  @@index([conceptId])
}

model Question {
  id String @id @default(cuid())

  quizId       String?
  quiz         Quiz?        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId     String?
  module       Module?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  title        String?
  question     String       @db.Text
  questionType QuestionType @default(MCQ_SINGLE)

  options       Json
  correctAnswer Json

  explanation String? @db.Text

  // A nudge toward the answer, shown DURING an attempt — as opposed to
  // `explanation` above, which justifies the answer after submission and
  // would give the answer away outright.
  //
  // Only a qualifying test surfaces it, and only from the student's second
  // attempt onward (see getQuizById): on a first attempt the test has to
  // measure what the student already knows, which is the whole basis for
  // letting them skip the content. It is withheld server-side, never merely
  // hidden in the UI, so a first attempt cannot read it off the wire.
  hint String? @db.Text

  subject       String?         @default("General")
  topic         String?         @default("General")
  tags          String?         @default("")
  marks         Int             @default(1)
  negativeMarks Float           @default(0)
  difficulty    DifficultyLevel @default(MEDIUM)
  status        String?         @default("ACTIVE")
  createdBy     String?
  creator       User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  isRequired    Boolean        @default(true)
  isPublished   Boolean        @default(true)
  quizQuestions QuizQuestion[]

  questionAttempts QuestionAttempt[]

  order Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([quizId])
  @@index([courseId])
  @@index([moduleId])
  @@index([difficulty])
  @@index([questionType])
  @@index([createdBy])
  @@index([status])
  @@index([topic])
  @@index([subject])
}

model QuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  questionId  String
  order       Int      @default(1)
  marks       Int      @default(1)
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([quizId, questionId])
  @@index([quizId])
  @@index([questionId])
}

model Review {
  id        String         @id @default(cuid())
  rating    Int
  review    String?
  courseId  String
  createdAt DateTime       @default(now())
  studentId String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model QuizSubmission {
  id            String         @id @default(cuid())
  quizId        String
  studentId     String
  answers       Json
  score         Int
  totalMarks    Int
  percentage    Int
  passed        Boolean        @default(false)
  conceptScores Json?
  submittedAt   DateTime       @default(now())
  quiz          Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, quizId])
  @@index([studentId])
}

// One row per quiz attempt — the student's full attempt history. QuizSubmission
// above stays the single "latest attempt" row that progress, dashboards and the
// instructor views read; this table is what makes earlier attempts reviewable
// and what Quiz.attempts is enforced against.
model QuizAttempt {
  id               String         @id @default(cuid())
  quizId           String
  studentId        String
  attemptNumber    Int
  answers          Json
  score            Int
  totalMarks       Int
  percentage       Int
  passed           Boolean        @default(false)
  correctCount     Int            @default(0)
  incorrectCount   Int            @default(0)
  unansweredCount  Int            @default(0)
  // Reported by the attempt UI; null when it wasn't measured.
  timeTakenSeconds Int?
  submittedAt      DateTime       @default(now())
  quiz             Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionAttempts QuestionAttempt[]

  @@unique([studentId, quizId, attemptNumber])
  @@index([quizId])
  @@index([studentId])
}

// One row per question per attempt — the question-level record the attempt
// summary is derived from, and what makes an attempt reviewable question by
// question rather than as one opaque `QuizAttempt.answers` blob.
//
// Written once, at submit, inside the same transaction as its QuizAttempt:
// a submitted attempt and its question rows are never out of step, and an
// earlier attempt's rows are never touched by a later one (each attempt owns
// its own set, keyed by quizAttemptId).
//
// `status` is where the question ENDED UP. `visited`/`skipped` are "did this
// ever happen" flags, which `status` alone cannot express — a question the
// student skipped and later answered ends ANSWERED with `skipped` still true.
// `answered` is kept in step with `status === ANSWERED` by the service and
// exists so the summary tallies read the same way for every flag.
//
// Deliberately NOT stored here: per-attempt counters (answered/skipped/
// correct totals). Those are folded from these rows — see
// summarizeQuestionAttempts() in quiz.service.js.
model QuestionAttempt {
  id            String                @id @default(cuid())
  quizAttemptId String
  questionId    String

  // The student's final answer for this question, in the same shape the
  // submit payload uses (string, string[], or an object for MATCH_PAIRS).
  // Null when the question was never answered.
  answer Json?

  status   QuestionAttemptStatus @default(NOT_VISITED)
  visited  Boolean               @default(false)
  skipped  Boolean               @default(false)
  answered Boolean               @default(false)

  // Graded server-side at submit. `isCorrect` is null for a question that was
  // never answered — "not correct" and "not attempted" are different facts.
  // `marksObtained` can go negative where the question carries negative marks.
  isCorrect     Boolean?
  marksObtained Float    @default(0)
  maxMarks      Float    @default(1)

  // Reserved for the hint feature — no quiz UI exposes hints today, so this
  // stays false until one does. Here now so adding hints needs no migration.
  hintViewed Boolean @default(false)

  // The question's position in the quiz at the time of the attempt, so a
  // later reorder can't scramble how a past attempt reads back.
  order Int?

  firstVisitedAt DateTime?
  lastVisitedAt  DateTime?
  answeredAt     DateTime?
  skippedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quizAttempt QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // One record per question per attempt — changing an answer updates this row,
  // it never adds a second one.
  @@unique([quizAttemptId, questionId])
  @@index([quizAttemptId])
  @@index([questionId])
  @@index([status])
}

