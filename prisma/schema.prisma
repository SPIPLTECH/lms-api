generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String          @id @default(cuid())
  name                 String
  email                String          @unique
  phoneNumber          String?         @unique
  address              String?
  password             String
  role                 Role            @default(STUDENT)
  refreshToken         String?
  status               UserStatus      @default(ACTIVE)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  isVerified           Boolean         @default(false)
  otp                  String?
  otpExpiresAt         DateTime?
  adminProfile         AdminProfile?
  courses              Course[]
  studentProfile       StudentProfile?
  teacherProfile       TeacherProfile?
  createdConversations Conversation[]  @relation("ConversationCreator")

  conversations ConversationParticipant[] @relation("ConversationParticipant")

  sentMessages Message[] @relation("MessageSender")
  notifications Notification[]
}

model StudentProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  education       String?
  phone           String?
  createdAt       DateTime         @default(now())
  dateOfBirth     DateTime?
  guardianName    String?
  updatedAt       DateTime         @updatedAt
  certificates    Certificate[]
  enrollments     Enrollment[]
  progress        Progress[]
  quizSubmissions QuizSubmission[]
  reviews         Review[]
  StickyNote      StickyNote[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  specialization String?
  qualification  String?
  experience     Int?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  department  String?
  designation String?
  permissions String[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id           String        @id @default(cuid())
  title        String
  description  String?
  category     String?
  level        String?
  thumbnailUrl String?
  status       CourseStatus  @default(DRAFT)
  publishedAt  DateTime?
  creatorId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  certificates Certificate[]
  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  modules      Module[]
  quizzes      Quiz[]
  reviews      Review[]
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int
  isPublished Boolean  @default(false)
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
}

model Lesson {
  id          String       @id @default(cuid())
  title       String
  description String?
  order       Int
  isPublished Boolean      @default(false)
  moduleId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  contents    Content[]
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    Progress[]
  StickyNote  StickyNote[]

  @@unique([moduleId, order])
}

model Content {
  id          String      @id @default(cuid())
  order       Int
  lessonId    String
  type        ContentType
  title       String?
  videoUrl    String?
  fileUrl     String?
  htmlContent String?
  externalUrl String?
  duration    Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
}

model Enrollment {
  id         String         @id @default(cuid())
  courseId   String
  enrolledAt DateTime       @default(now())
  studentId  String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Progress {
  id          String         @id @default(cuid())
  lessonId    String
  completed   Boolean        @default(false)
  completedAt DateTime?
  studentId   String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model Quiz {
  id              String           @id @default(cuid())
  title           String
  description     String?
  passingScore    Int
  timeLimit       Int?
  courseId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  questions       Question[]
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizSubmissions QuizSubmission[]
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  question      String
  options       Json
  correctAnswer String
  marks         Int      @default(1)
  createdAt     DateTime @default(now())
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Review {
  id        String         @id @default(cuid())
  rating    Int
  review    String?
  courseId  String
  createdAt DateTime       @default(now())
  studentId String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model QuizSubmission {
  id          String         @id @default(cuid())
  quizId      String
  studentId   String
  answers     Json
  score       Int
  totalMarks  Int
  percentage  Int
  passed      Boolean        @default(false)
  submittedAt DateTime       @default(now())
  quiz        Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, quizId])
}

model Certificate {
  id            String         @id @default(cuid())
  certificateNo String         @unique
  courseId      String
  issuedAt      DateTime       @default(now())
  studentId     String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model StickyNote {
  id             String         @id
  content        String
  color          String?        @default("yellow")
  isPinned       Boolean        @default(false)
  timestamp      Int?
  studentId      String
  lessonId       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  Lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  StudentProfile StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([studentId])
  @@index([studentId, lessonId])
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  VIDEO
  DOCUMENT
  TEXT
  LINK
  PRESENTATION
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum AttachmentType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType
  name        String?
  description String?
  image       String?

  createdById String
  createdBy   User   @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([updatedAt])
}

model ConversationParticipant {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationParticipant", fields: [userId], references: [id], onDelete: Cascade)

  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  isPinned Boolean @default(false)
  isMuted  Boolean @default(false)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  content String @db.Text

  isEdited Boolean @default(false)
  editedAt DateTime?

  isDeleted Boolean @default(false)
  deletedAt DateTime?

  // NEW
  isStarred Boolean @default(false)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messageAttachments MessageAttachment[]

  @@index([conversationId])
  @@index([senderId])
  @@index([expiresAt])
}
model MessageAttachment {
  id String @id @default(cuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String
  mimeType String
  size     Int
  type     AttachmentType

  createdAt DateTime @default(now())

  @@index([messageId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
