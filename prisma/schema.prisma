generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  phoneNumber             String?                   @unique
  address                 String?
  password                String
  role                    Role                      @default(STUDENT)
  refreshToken            String?
  status                  UserStatus                @default(ACTIVE)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  isVerified              Boolean                   @default(false)
  otp                     String?
  otpExpiresAt            DateTime?
  adminProfile            AdminProfile?
  announcements           Announcement[]
  Conversation            Conversation[]
  ConversationParticipant ConversationParticipant[]
  courses                 Course[]
  CourseImportJob         CourseImportJob[]
  discussions             Discussion[]
  discussionReplies       DiscussionReply[]
  lessonNotes             InstructorLessonNote[]
  mentorConversations     MentorConversation[]
  mentorMemories          MentorMemory[]
  Message                 Message[]
  notifications           Notification[]
  createdQuestions        Question[]
  mentorFeedback          ResponseFeedback[]
  studentProfile          StudentProfile?
  teacherProfile          TeacherProfile?
  teachingGoals           TeachingGoal[]
  paymentOrders           PaymentOrder[]
}

model StudentProfile {
  id                          String                        @id @default(cuid())
  userId                      String                        @unique
  education                   String?
  phone                       String?
  createdAt                   DateTime                      @default(now())
  dateOfBirth                 DateTime?
  guardianName                String?
  profileVisibility           String?                       @default("Public")
  focusTopics                 String?                       @default("")
  interests                   String?                       @default("")
  learningGoals               String?                       @default("")
  videoQuality                String?                       @default("Auto")
  downloadOverWifi            Boolean?                      @default(true)
  language                    String?                       @default("English")
  timezone                    String?                       @default("GMT+05:30")
  themeMode                   String?                       @default("Dark Mode")
  plan                        String?                       @default("Free Plan")
  updatedAt                   DateTime                      @updatedAt
  gender                      String?
  branchOrStream              String?
  careerGoalText              String?
  cgpaOrPercentage            Float?
  city                        String?
  collegeName                 String?
  country                     String?
  currentJobRole              String?
  currentQualification        String?
  employmentStatus            EmploymentStatus?
  highestQualification        String?
  preferredLearningStyle      PreferredLearningStyle?
  preferredStudyTime          PreferredStudyTime?
  semester                    String?
  state                       String?
  technicalSkills             String[]                      @default([])
  weeklyStudyHours            Int?
  yearsOfExperience           Float?                        @default(0)
  graduationYear              Int?
  applications                Application[]
  assessments                 Assessment[]
  assignmentSubmissions       AssignmentSubmission[]
  bookmarks                   Bookmark[]
  careerGoals                 CareerGoal[]
  careerProfile               CareerProfile?
  careerReadinessHistory      CareerReadinessHistory[]
  careerRecommendations       CareerRecommendation[]
  careerRecommendationHistory CareerRecommendationHistory[]
  careerRoadmaps              CareerRoadmap[]
  certificates                Certificate[]
  conceptMasteries            ConceptMastery[]
  engagementTrends            EngagementTrend[]
  enrollments                 Enrollment[]
  entryAssessments            EntryAssessment[]
  interviews                  Interview[]
  jobMatches                  JobMatch[]
  knowledgeGaps               KnowledgeGap[]
  learningEvents              LearningEvent[]
  learningPathGoals           LearningGoal[]
  learningMilestones          LearningMilestone[]
  learningPath                LearningPath?
  learningRecommendations     LearningRecommendation[]
  lessonQueries               LessonQuery[]
  motivationActions           MotivationAction[]
  notes                       Note[]
  offers                      Offer[]
  placementProfile            PlacementProfile?
  progress                    Progress[]
  quizSubmissions             QuizSubmission[]
  reassessmentPlans           ReassessmentPlan[]
  recommendations             Recommendation[]
  reminderSchedules           ReminderSchedule[]
  resumeReviews               ResumeReview[]
  reviews                     Review[]
  revisionPlans               RevisionPlan[]
  skillAssessments            SkillAssessment[]
  skillGaps                   SkillGap[]
  stickyNotes                 StickyNote[]
  achievements                StudentAchievement[]
  activityState               StudentActivityState?
  studentAlerts               StudentAlert[]
  courseStates                StudentCourseState[]
  learningState               StudentLearningState?
  user                        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentStates               StudentState[]
  streak                      StudentStreak?
  studyPlans                  StudyPlan[]
  videoAnalytics              VideoAnalytics[]
  batches                     Batch[]                       @relation("BatchToStudentProfile")
}

model TeacherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  specialization String?
  qualification  String?
  experience     Int?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  department  String?
  designation String?
  permissions String[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id                           String                   @id @default(cuid())
  title                        String
  description                  String?
  category                     String?
  level                        String?
  thumbnailUrl                 String?
  status                       CourseStatus             @default(DRAFT)
  publishedAt                  DateTime?
  creatorId                    String
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  certificatesEnabled          Boolean                  @default(false)
  discussionEnabled            Boolean                  @default(true)
  dripContentEnabled           Boolean                  @default(false)
  estimatedLearningHours       Float?
  language                     String?                  @default("English")
  tags                         String[]                 @default([])
  visibility                   CourseVisibility         @default(PUBLIC)
  announcements                Announcement[]
  assignments                  Assignment[]
  Batch_Batch_courseIdToCourse Batch[]                  @relation("Batch_courseIdToCourse")
  batchSessions                BatchSession[]
  certificates                 Certificate[]
  creator                      User                     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  courseHealth                 CourseHealth?
  courseInsights               CourseInsight[]
  discussions                  Discussion[]
  enrollments                  Enrollment[]
  entryAssessments             EntryAssessment[]
  exams                        Exam[]
  learningEvents               LearningEvent[]
  learningPathGoals            LearningGoal[]
  learningMilestones           LearningMilestone[]
  liveClasses                  LiveClass[]
  modules                      Module[]
  questions                    Question[]
  quizzes                      Quiz[]
  reviews                      Review[]
  store                        Store?
  studentAlerts                StudentAlert[]
  studentCourseStates          StudentCourseState[]
  studentStates                StudentState[]
  teacherInsights              TeacherInsight[]
  teachingRecommendations      TeachingRecommendation[]
  videoAnalytics               VideoAnalytics[]
  batches                      Batch[]                  @relation("BatchToCourse")
  paymentOrders                PaymentOrder[]
}

model Store {
  id            String   @id @default(cuid())
  price         Float    @default(0)
  discountPrice Float?
  currency      String   @default("INR")
  isFree        Boolean  @default(false)
  courseId      String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Module {
  id          String     @id @default(cuid())
  title       String
  description String?
  order       Int
  isPublished Boolean    @default(false)
  courseId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lessons     Lesson[]
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   Question[]

  @@unique([courseId, order])
}

model Lesson {
  id              String                 @id @default(cuid())
  title           String
  description     String?
  order           Int
  isPublished     Boolean                @default(false)
  moduleId        String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  contents        Content[]
  instructorNotes InstructorLessonNote[]
  module          Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  queries         LessonQuery[]
  progress        Progress[]
  stickyNotes     StickyNote[]
  videoAnalytics  VideoAnalytics[]

  @@unique([moduleId, order])
}

model Content {
  id          String      @id @default(cuid())
  order       Int
  lessonId    String
  type        ContentType
  title       String?
  videoUrl    String?
  fileUrl     String?
  htmlContent String?
  externalUrl String?
  duration    Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  data        Json?
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
}

model LessonQuery {
  id         String            @id @default(cuid())
  lessonId   String
  studentId  String
  question   String
  reply      String?
  status     LessonQueryStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  answeredAt DateTime?
  lesson     Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student    StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([studentId])
}

model StickyNote {
  id        String         @id @default(cuid())
  content   String
  color     String?        @default("yellow")
  isPinned  Boolean        @default(false)
  timestamp Int?
  studentId String
  lessonId  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([lessonId])
  @@index([studentId, lessonId])
}

model Enrollment {
  id             String         @id @default(cuid())
  courseId       String
  enrolledAt     DateTime       @default(now())
  lastAccessedAt DateTime?
  studentId      String
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Progress {
  id          String         @id @default(cuid())
  lessonId    String
  completed   Boolean        @default(false)
  completedAt DateTime?
  studentId   String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model Quiz {
  id               String           @id @default(cuid())
  title            String
  description      String?
  passingScore     Int
  timeLimit        Int?
  startDate        DateTime?
  dueDate          DateTime?
  availableFrom    DateTime?
  availableUntil   DateTime?
  isPublished      Boolean          @default(true)
  status           String?          @default("ACTIVE")
  courseId         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  attempts         Int              @default(1)
  instructions     String?
  negativeMarking  Float            @default(0)
  shuffleOptions   Boolean          @default(false)
  shuffleQuestions Boolean          @default(false)
  questions        Question[]
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizQuestions    QuizQuestion[]
  quizSubmissions  QuizSubmission[]
}

model Question {
  id            String          @id @default(cuid())
  question      String
  questionType  QuestionType    @default(MCQ_SINGLE)
  options       Json
  correctAnswer Json
  explanation   String?
  marks         Int             @default(1)
  negativeMarks Float           @default(0)
  difficulty    DifficultyLevel @default(MEDIUM)
  isRequired    Boolean         @default(true)
  isPublished   Boolean         @default(true)
  order         Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  createdBy     String?
  status        String?         @default("ACTIVE")
  tags          String?         @default("")
  courseId      String?
  moduleId      String?
  quizId        String?
  subject       String?
  title         String?
  topic         String?
  course        Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator       User?           @relation(fields: [createdBy], references: [id])
  module        Module?         @relation(fields: [moduleId], references: [id])
  quiz          Quiz?           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]

  @@index([quizId])
  @@index([courseId])
  @@index([moduleId])
  @@index([subject])
  @@index([topic])
  @@index([difficulty])
  @@index([questionType])
  @@index([createdBy])
  @@index([status])
}

model QuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  questionId  String
  order       Int      @default(1)
  marks       Int      @default(1)
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, questionId])
  @@index([quizId])
  @@index([questionId])
}

model Review {
  id        String         @id @default(cuid())
  rating    Int
  review    String?
  courseId  String
  createdAt DateTime       @default(now())
  studentId String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model QuizSubmission {
  id            String         @id @default(cuid())
  quizId        String
  studentId     String
  answers       Json
  score         Int
  totalMarks    Int
  percentage    Int
  passed        Boolean        @default(false)
  conceptScores Json?
  submittedAt   DateTime       @default(now())
  quiz          Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, quizId])
  @@index([studentId])
}

model Certificate {
  id            String         @id @default(cuid())
  certificateNo String         @unique
  courseId      String
  issuedAt      DateTime       @default(now())
  studentId     String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Conversation {
  id           String                    @id @default(cuid())
  type         ConversationType
  name         String?
  image        String?
  createdById  String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  User         User                      @relation(fields: [createdById], references: [id])
  participants ConversationParticipant[]
  Message      Message[]

  @@index([createdById])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id                 String              @id @default(cuid())
  conversationId     String
  senderId           String
  content            String?
  isEdited           Boolean             @default(false)
  editedAt           DateTime?
  isDeleted          Boolean             @default(false)
  deletedAt          DateTime?
  isStarred          Boolean             @default(false)
  expiresAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender             User                @relation(fields: [senderId], references: [id])
  messageAttachments MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  fileName  String
  fileUrl   String
  mimeType  String
  size      Int
  type      AttachmentType
  createdAt DateTime       @default(now())
  Message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Note {
  id        String         @id @default(cuid())
  title     String
  content   String?
  category  String?        @default("General")
  starred   Boolean        @default(false)
  studentId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Bookmark {
  id        String         @id @default(cuid())
  type      String
  title     String
  detail    String?
  url       String?
  courseId  String?
  lessonId  String?
  studentId String
  createdAt DateTime       @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model LiveClass {
  id             String          @id @default(cuid())
  title          String
  topic          String?
  courseId       String
  instructorId   String
  scheduledAt    DateTime
  duration       Int?
  meetingUrl     String?
  status         LiveClassStatus @default(SCHEDULED)
  startDate      DateTime?
  dueDate        DateTime?
  availableFrom  DateTime?
  availableUntil DateTime?
  startTime      String?
  endTime        String?
  meetingLink    String?
  isPublished    Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([scheduledAt])
}

model Achievement {
  id          String               @id @default(cuid())
  name        String
  description String?
  icon        String?
  xpReward    Int                  @default(0)
  type        AchievementType
  createdAt   DateTime             @default(now())
  earned      StudentAchievement[]
}

model StudentAchievement {
  id            String         @id @default(cuid())
  studentId     String
  achievementId String
  earnedAt      DateTime       @default(now())
  achievement   Achievement    @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementId])
  @@index([studentId])
}

model Assignment {
  id             String                 @id @default(cuid())
  title          String
  description    String?
  startDate      DateTime?
  dueDate        DateTime
  totalQuestions Int?                   @default(0)
  estimatedTime  Int?                   @default(0)
  resources      Int?                   @default(0)
  availableFrom  DateTime?
  availableUntil DateTime?
  isPublished    Boolean                @default(true)
  status         String?                @default("ACTIVE")
  courseId       String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  course         Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions    AssignmentSubmission[]

  @@index([courseId])
}

model AssignmentSubmission {
  id           String         @id @default(cuid())
  assignmentId String
  studentId    String
  status       String         @default("Submitted")
  grade        String?
  feedback     String?
  submittedAt  DateTime       @default(now())
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assignmentId])
  @@index([studentId])
}

model CalendarEvent {
  id             String   @id @default(cuid())
  title          String
  type           String
  date           String
  startTime      String?
  endTime        String?
  description    String?
  instructorId   String?
  instructorName String?
  link           String?
  maxMarks       Int?
  courseId       String?
  courseName     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Exam {
  id             String    @id @default(cuid())
  title          String
  description    String?
  startDate      DateTime
  duration       Int?
  dueDate        DateTime?
  availableFrom  DateTime?
  availableUntil DateTime?
  examDate       DateTime?
  startTime      String?
  endTime        String?
  meetingLink    String?
  status         String?   @default("SCHEDULED")
  isPublished    Boolean   @default(true)
  courseId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Batch {
  id                            String           @id @default(cuid())
  name                          String
  startDate                     DateTime
  dueDate                       DateTime?
  availableFrom                 DateTime?
  availableUntil                DateTime?
  startTime                     String?
  endTime                       String?
  meetingLink                   String?
  status                        String?          @default("ACTIVE")
  isPublished                   Boolean          @default(true)
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt
  courseId                      String
  announcements                 Announcement[]
  Course_Batch_courseIdToCourse Course           @relation("Batch_courseIdToCourse", fields: [courseId], references: [id], onDelete: Cascade)
  sessions                      BatchSession[]
  courses                       Course[]         @relation("BatchToCourse")
  students                      StudentProfile[] @relation("BatchToStudentProfile")

  @@index([courseId])
}

model BatchSession {
  id             String    @id @default(cuid())
  title          String
  description    String?
  startDate      DateTime
  dueDate        DateTime?
  availableFrom  DateTime?
  availableUntil DateTime?
  examDate       DateTime?
  startTime      String?
  endTime        String?
  meetingLink    String?
  status         String?   @default("SCHEDULED")
  isPublished    Boolean   @default(true)
  courseId       String
  batchId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  batch          Batch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudentState {
  id        String         @id @default(cuid())
  studentId String
  courseId  String
  moduleId  String?
  lessonId  String?
  contentId String?
  timestamp Int?           @default(0)
  updatedAt DateTime       @updatedAt
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model LearningEvent {
  id              String         @id @default(cuid())
  studentId       String
  courseId        String?
  moduleId        String?
  lessonId        String?
  contentId       String?
  quizId          String?
  assignmentId    String?
  sessionId       String
  eventType       EventType
  eventCategory   EventCategory
  payload         Json?
  metadata        Json?
  source          String?
  ipAddress       String?
  userAgent       String?
  clientTimestamp DateTime?
  createdAt       DateTime       @default(now())
  course          Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([courseId, createdAt])
  @@index([sessionId])
  @@index([eventType, createdAt])
  @@index([eventCategory, createdAt])
  @@index([createdAt])
}

model StudentActivityState {
  id                 String         @id @default(cuid())
  studentId          String         @unique
  totalEventsCount   Int            @default(0)
  totalSessionsCount Int            @default(0)
  lastEventType      EventType?
  lastEventCategory  EventCategory?
  lastSessionId      String?
  lastCourseId       String?
  lastModuleId       String?
  lastLessonId       String?
  lastActiveAt       DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([lastActiveAt])
}

model StudentLearningState {
  id                   String              @id @default(cuid())
  studentId            String              @unique
  overallLearningScore Float               @default(0)
  engagementScore      Float               @default(0)
  performanceScore     Float               @default(0)
  consistencyScore     Float               @default(0)
  learningHealthScore  Float               @default(0)
  lastEventId          String?
  lastEventAt          DateTime?
  lastRecalculatedAt   DateTime?
  version              Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  behavior             StudentBehavior?
  engagement           StudentEngagement?
  student              StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  performance          StudentPerformance?
  progress             StudentProgress?
  risk                 StudentRisk?

  @@index([updatedAt])
}

