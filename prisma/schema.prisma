generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  phoneNumber             String?                   @unique
  address                 String?
  password                String
  role                    Role                      @default(STUDENT)
  refreshToken            String?
  status                  UserStatus                @default(ACTIVE)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  isVerified              Boolean                   @default(false)
  otp                     String?
  otpExpiresAt            DateTime?
  adminProfile            AdminProfile?
  Conversation            Conversation[]
  ConversationParticipant ConversationParticipant[]
  courses                 Course[]
  Message                 Message[]
  studentProfile          StudentProfile?
  teacherProfile          TeacherProfile?
}

model StudentProfile {
  id                String               @id @default(cuid())
  userId            String               @unique
  education         String?
  phone             String?
  createdAt         DateTime             @default(now())
  dateOfBirth       DateTime?
  guardianName      String?
  profileVisibility String?              @default("Public")
  focusTopics       String?              @default("")
  interests         String?              @default("")
  learningGoals     String?              @default("")
  videoQuality      String?              @default("Auto")
  downloadOverWifi  Boolean?             @default(true)
  language          String?              @default("English")
  timezone          String?              @default("GMT+05:30")
  themeMode         String?              @default("Dark Mode")
  plan              String?              @default("Free Plan")
  updatedAt         DateTime             @updatedAt
  certificates      Certificate[]
  enrollments       Enrollment[]
  progress          Progress[]
  quizSubmissions   QuizSubmission[]
  reviews           Review[]
  stickyNotes       StickyNote[]
  notes             Note[]
  bookmarks         Bookmark[]
  achievements      StudentAchievement[]
  assignmentSubmissions AssignmentSubmission[]
  batches               Batch[]
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  specialization String?
  qualification  String?
  experience     Int?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  department  String?
  designation String?
  permissions String[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id           String        @id @default(cuid())
  title        String
  description  String?
  category     String?
  level        String?
  thumbnailUrl String?
  status       CourseStatus  @default(DRAFT)
  publishedAt  DateTime?
  creatorId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  certificates Certificate[]
  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  modules      Module[]
  quizzes      Quiz[]
  reviews      Review[]
  liveClasses  LiveClass[]
  assignments  Assignment[]
  exams        Exam[]
  batches      Batch[]
  batchSessions BatchSession[]
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int
  isPublished Boolean  @default(false)
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
}

model Lesson {
  id          String       @id @default(cuid())
  title       String
  description String?
  order       Int
  isPublished Boolean      @default(false)
  moduleId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  contents    Content[]
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    Progress[]
  stickyNotes StickyNote[]

  @@unique([moduleId, order])
}

model Content {
  id          String      @id @default(cuid())
  order       Int
  lessonId    String
  type        ContentType
  title       String?
  videoUrl    String?
  fileUrl     String?
  htmlContent String?
  externalUrl String?
  duration    Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
}

model StickyNote {
  id        String         @id @default(cuid())
  content   String
  color     String?        @default("yellow")
  isPinned  Boolean        @default(false)
  timestamp Int?
  studentId String
  lessonId  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([lessonId])
  @@index([studentId, lessonId])
}

model Enrollment {
  id         String         @id @default(cuid())
  courseId   String
  enrolledAt DateTime       @default(now())
  studentId  String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Progress {
  id          String         @id @default(cuid())
  lessonId    String
  completed   Boolean        @default(false)
  completedAt DateTime?
  studentId   String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model Quiz {
  id              String           @id @default(cuid())
  title           String
  description     String?
  passingScore    Int
  timeLimit       Int?
  startDate       DateTime?
  dueDate        DateTime?
  availableFrom  DateTime?
  availableUntil DateTime?
  isPublished    Boolean          @default(true)
  status         String?          @default("ACTIVE")
  courseId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  questions       Question[]
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizSubmissions QuizSubmission[]
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  question      String
  options       Json
  correctAnswer String
  marks         Int      @default(1)
  createdAt     DateTime @default(now())
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Review {
  id        String         @id @default(cuid())
  rating    Int
  review    String?
  courseId  String
  createdAt DateTime       @default(now())
  studentId String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model QuizSubmission {
  id          String         @id @default(cuid())
  quizId      String
  studentId   String
  answers     Json
  score       Int
  totalMarks  Int
  percentage  Int
  passed      Boolean        @default(false)
  submittedAt DateTime       @default(now())
  quiz        Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, quizId])
}

model Certificate {
  id            String         @id @default(cuid())
  certificateNo String         @unique
  courseId      String
  issuedAt      DateTime       @default(now())
  studentId     String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Conversation {
  id                      String                    @id @default(cuid())
  type                    ConversationType
  name                    String?
  image                   String?
  createdById             String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  User                    User                      @relation(fields: [createdById], references: [id])
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]

  @@index([createdById])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id                String              @id @default(cuid())
  conversationId    String
  senderId          String
  content           String?
  isEdited          Boolean             @default(false)
  editedAt          DateTime?
  isDeleted         Boolean             @default(false)
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  Conversation      Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User              User                @relation(fields: [senderId], references: [id])
  MessageAttachment MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  fileName  String
  fileUrl   String
  mimeType  String
  size      Int
  type      AttachmentType
  createdAt DateTime       @default(now())
  Message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  VIDEO
  DOCUMENT
  TEXT
  LINK
  PRESENTATION
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum AttachmentType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

enum ConversationType {
  DIRECT
  GROUP
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum AchievementType {
  COURSE
  QUIZ
  STREAK
  NOTE
  GENERAL
}

model Note {
  id        String         @id @default(cuid())
  title     String
  content   String?
  category  String?        @default("General")
  starred   Boolean        @default(false)
  studentId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Bookmark {
  id        String         @id @default(cuid())
  type      String
  title     String
  detail    String?
  url       String?
  courseId  String?
  lessonId  String?
  studentId String
  createdAt DateTime       @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model LiveClass {
  id           String          @id @default(cuid())
  title        String
  topic        String?
  courseId     String
  instructorId String
  scheduledAt  DateTime
  duration     Int?
  meetingUrl   String?
  status       LiveClassStatus @default(SCHEDULED)
  startDate      DateTime?
  dueDate        DateTime?
  availableFrom  DateTime?
  availableUntil DateTime?
  startTime      String?
  endTime        String?
  meetingLink    String?
  isPublished    Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  course       Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([scheduledAt])
}

model Achievement {
  id          String               @id @default(cuid())
  name        String
  description String?
  icon        String?
  xpReward    Int                  @default(0)
  type        AchievementType
  createdAt   DateTime             @default(now())
  earned      StudentAchievement[]
}

model StudentAchievement {
  id            String         @id @default(cuid())
  studentId     String
  achievementId String
  earnedAt      DateTime       @default(now())
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievement   Achievement    @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementId])
  @@index([studentId])
}

model Assignment {
  id             String                 @id @default(cuid())
  title          String
  description    String?
  startDate      DateTime?
  dueDate        DateTime
  totalQuestions Int?                   @default(0)
  estimatedTime  Int?                   @default(0)
  resources      Int?                   @default(0)
  availableFrom  DateTime?
  availableUntil DateTime?
  isPublished    Boolean                @default(true)
  status         String?                @default("ACTIVE")
  courseId       String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  course         Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions    AssignmentSubmission[]

  @@index([courseId])
}

model AssignmentSubmission {
  id           String         @id @default(cuid())
  assignmentId String
  studentId    String
  status       String         @default("Submitted")
  grade        String?
  feedback     String?
  submittedAt  DateTime       @default(now())
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assignmentId])
  @@index([studentId])
}

model CalendarEvent {
  id             String   @id @default(cuid())
  title          String
  type           String
  date           String
  startTime      String?
  endTime        String?
  description    String?
  instructorId   String?
  instructorName String?
  link           String?
  maxMarks       Int?
  courseId       String?
  courseName     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Exam {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  duration    Int?     // in minutes
  dueDate        DateTime?
  availableFrom  DateTime?
  availableUntil DateTime?
  examDate       DateTime?
  startTime      String?
  endTime        String?
  meetingLink    String?
  status         String?         @default("SCHEDULED")
  isPublished    Boolean         @default(true)
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Batch {
  id          String           @id @default(cuid())
  name        String
  startDate   DateTime
  dueDate        DateTime?
  availableFrom  DateTime?
  availableUntil DateTime?
  startTime      String?
  endTime        String?
  meetingLink    String?
  status         String?          @default("ACTIVE")
  isPublished    Boolean          @default(true)
  courseId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  students    StudentProfile[]
  sessions       BatchSession[]

  @@index([courseId])
}

model BatchSession {
  id             String    @id @default(cuid())
  title          String
  description    String?
  startDate      DateTime
  dueDate        DateTime?
  availableFrom  DateTime?
  availableUntil DateTime?
  examDate       DateTime?
  startTime      String?
  endTime        String?
  meetingLink    String?
  status         String?   @default("SCHEDULED")
  isPublished    Boolean   @default(true)
  courseId       String
  batchId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch          Batch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

