# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/orange_lms?schema=public"

# Server Configuration
PORT=5000
FRONTEND_URL="http://localhost:3000"

# JWT Authentication Secrets
JWT_SECRET="your_jwt_secret_key_here"
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
ACCESS_TOKEN_EXPIRE="1d"
REFRESH_TOKEN_EXPIRE="7d"

# Email Delivery (Brevo / SMTP)
BREVO_API_KEY="your_brevo_api_key"
BREVO_HOST="smtp-relay.brevo.com"
BREVO_PORT=587
BREVO_USER="your_smtp_user"
BREVO_PASS="your_smtp_password"
MAIL_FROM="noreply@yourdomain.com"

# Local LLM (Ollama) - LLM Gateway
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_TIMEOUT_MS=60000
OLLAMA_THINK_TIMEOUT_MS=180000
OLLAMA_MAX_OUTPUT_TOKENS=1024

# Razorpay Integration (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
