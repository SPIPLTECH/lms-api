# Orange Tree LMS API — Environment Template
# Copy to .env for local development. Never commit real secrets.
#
# Generate each JWT secret independently (64 random bytes = 128 hex chars):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/orange_lms"
# Optional disposable database for integration test suites:
# TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/orange_lms_test"

# JWT Signing Secrets (MUST be >= 32 chars in production; 64-byte hex recommended)
JWT_SECRET="<replace-with-64-byte-hex-secret>"
JWT_ACCESS_SECRET="<replace-with-64-byte-hex-secret>"
JWT_REFRESH_SECRET="<replace-with-64-byte-hex-secret>"
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRE=15m
SESSION_IDLE_TIMEOUT_MINUTES=30

# CORS & Frontend Origins (comma-separated exact origins in production)
FRONTEND_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
# Automatically false when NODE_ENV=production unless explicitly overridden
ALLOW_LAN_ORIGINS=true

# Diagnostics (keep false in production to avoid exposing DB/app timings)
ENABLE_SERVER_TIMING=false

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BUCKET=""
R2_PRIVATE_BUCKET=""
R2_PUBLIC_URL=""

# Email (Brevo)
BREVO_API_KEY=""
BREVO_HOST="smtp-relay.brevo.com"
BREVO_PORT=587
BREVO_USER=""
BREVO_PASS=""
MAIL_FROM=""

# AI Providers (Optional)
GEMINI_API_KEY=""
GEMINI_FALLBACK_MODELS=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5"

# ---------------------------------------------------------------------------
# Proctoring. Off unless PROCTORING_ENABLED=true. In production it also needs
# PROCTORING_LIVE_ALLOWED=true, which the owner sets only after legal sign-off.
# ---------------------------------------------------------------------------
PROCTORING_ENABLED=false
PROCTORING_LIVE_ALLOWED=false
# Signs monitoring tokens. A long random value.
PROCTORING_TOKEN_SECRET=
# id:<base64 of 32 random bytes>. The first encrypts; all decrypt, for rotation: k2:...,k1:...
PROCTORING_EVIDENCE_KEYS=
# r2 (default) or local (development only).
PROCTORING_STORAGE_DRIVER=r2
# A private bucket of its own. Do not reuse the LMS bucket or give it a public URL.
PROCTORING_R2_ENDPOINT=
PROCTORING_R2_BUCKET=
PROCTORING_R2_ACCESS_KEY_ID=
PROCTORING_R2_SECRET_ACCESS_KEY=
PROCTORING_LOCAL_STORE_DIR=
# Frames wait here before analysis. Needs fast disk, and room for about a minute of frames per student.
PROCTORING_TEMP_DIR=
# Seconds between frames (default 5). The server tells browsers, and lengthens it under load, up to 15.
PROCTORING_CAPTURE_INTERVAL_SECONDS=5
PROCTORING_MIN_BROWSER_VERSION=120
PROCTORING_UPLOAD_GAP_SECONDS=60
PROCTORING_SWEEP_CRON=
PROCTORING_RETENTION_CRON=

# The Python AI (ai/). On this machine the API starts it; on another server, point the URL there.
# It needs http on loopback, or https elsewhere.
AI_SERVICE_URL=http://127.0.0.1:8018
# A long random value, shared with the AI process.
AI_SERVICE_TOKEN=
AI_MANAGED=true
AI_PYTHON=
# Compare the face to the identity photo during the exam. The consent wording follows this.
AI_IDENTITY_MATCHING=true
AI_ANALYSIS_CONCURRENCY=2
AI_ANALYSIS_QUEUE_MAX=500
AI_WORKERS=2
AI_SERVICE_TIMEOUT_MS=3000
# The only rules that may end an exam. Everything else flags it.
AI_TERMINATING_RULES=CONFIRMED_PROHIBITED_OBJECT,PERSISTENT_MULTIPLE_FACES
AI_AUTO_TERMINATE_ENABLED=true
AI_AUTO_TERMINATE_MIN_CONFIDENCE=0.8
AI_AUTO_TERMINATE_OBJECT_MIN_CONFIDENCE=0.6
AI_TERMINATE_PERSIST_SECONDS=10
AI_RECHECK_SECONDS=2
AI_IDENTITY_MATCH_THRESHOLD=0.363
